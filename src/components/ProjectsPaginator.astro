---
import type { Project } from '../data/profile';

interface Props {
	projects: Project[];
}

const { projects } = Astro.props;
---

<div
	id="projects-paginator"
	class="space-y-5"
	data-projects={JSON.stringify(projects)}
>
	<div class="relative group/paginator">
		<div class="overflow-hidden rounded-xl -m-1.5 p-1.5">
			<div
				id="projects-grid"
				class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 items-stretch transition-all duration-500 ease-out"
				style="transform: translateX(0); opacity: 1;"
				aria-live="polite"
			>
				<!-- JS will fill this -->
			</div>
		</div>

		<button
			id="prev-btn"
			type="button"
			aria-label="Previous projects page"
			class="absolute left-0 top-0 bottom-0 z-20 w-14 md:w-20 flex items-center justify-start pl-1 md:pl-3 bg-gradient-to-r from-[color:var(--ink-800)]/95 via-[color:var(--ink-800)]/60 to-transparent opacity-100 md:opacity-0 md:group-hover/paginator:opacity-100 md:group-focus-within/paginator:opacity-100 focus-visible:opacity-100 transition-all duration-300 ease-out disabled:opacity-0! disabled:pointer-events-none cursor-pointer group/btn rounded-l-xl"
		>
			<span class="h-11 w-11 md:h-12 md:w-12 rounded-full border border-[color:var(--ink-500)] bg-[color:var(--ink-850)] text-[color:var(--paper)] group-hover/btn:border-[color:var(--accent)] group-hover/btn:bg-[color:var(--accent)] group-hover/btn:scale-110 active:scale-95 shadow-xl shadow-black/40 transition-all duration-200 flex items-center justify-center">
				<iconify-icon icon="mdi:chevron-left" class="text-3xl md:text-4xl"></iconify-icon>
			</span>
		</button>

		<button
			id="next-btn"
			type="button"
			aria-label="Next projects page"
			class="absolute right-0 top-0 bottom-0 z-20 w-14 md:w-20 flex items-center justify-end pr-1 md:pr-3 bg-gradient-to-l from-[color:var(--ink-800)]/95 via-[color:var(--ink-800)]/60 to-transparent opacity-100 md:opacity-0 md:group-hover/paginator:opacity-100 md:group-focus-within/paginator:opacity-100 focus-visible:opacity-100 transition-all duration-300 ease-out disabled:opacity-0! disabled:pointer-events-none cursor-pointer group/btn rounded-r-xl"
		>
			<span class="h-11 w-11 md:h-12 md:w-12 rounded-full border border-[color:var(--ink-500)] bg-[color:var(--ink-850)] text-[color:var(--paper)] group-hover/btn:border-[color:var(--accent)] group-hover/btn:bg-[color:var(--accent)] group-hover/btn:scale-110 active:scale-95 shadow-xl shadow-black/40 transition-all duration-200 flex items-center justify-center">
				<iconify-icon icon="mdi:chevron-right" class="text-3xl md:text-4xl"></iconify-icon>
			</span>
		</button>
	</div>

	<div class="flex items-center justify-center pt-1 gap-4">
		<p id="page-count" class="text-xs font-mono text-[color:var(--paper-dim)] tabular-nums" aria-hidden="true"></p>
		<div id="page-info" class="flex items-center justify-center gap-2" role="tablist" aria-label="Project pages">
		</div>
	</div>
</div>

<script>
const paginator = document.getElementById('projects-paginator') as HTMLElement;
const grid = document.getElementById('projects-grid') as HTMLDivElement;
const prevBtn = document.getElementById('prev-btn') as HTMLButtonElement;
const nextBtn = document.getElementById('next-btn') as HTMLButtonElement;
const pageInfo = document.getElementById('page-info') as HTMLElement;
const pageCount = document.getElementById('page-count') as HTMLElement;

type PaginatorProject = {
	title: string;
	role: string;
	period: string;
	description: string;
	link: string | null;
	achievements: string[];
	technologies?: string[];
};

const projects = JSON.parse(paginator.dataset.projects || '[]') as PaginatorProject[];
let currentPage = 0;
let isAnimating = false;
let touchStartX = 0;
let touchStartY = 0;
let touchStartTime = 0;
const expanded = new Set<string>();

const getItemsPerPage = (): number => (window.innerWidth >= 1024 ? 3 : 2);
const transitionMs = 320;
const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

const esc = (s: string): string =>
	s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

const isInternal = (link: string): boolean => link.startsWith('/');

const renderPageDots = (totalPages: number): void => {
	pageInfo.innerHTML = Array.from({ length: totalPages }, (_, pageIndex) => {
		const active = pageIndex === currentPage;
		return `<button type="button" role="tab" aria-selected="${active}" aria-label="Go to projects page ${pageIndex + 1}" data-page="${pageIndex}" class="rounded-full transition-all duration-200 cursor-pointer ${active ? 'h-2 w-6 bg-[color:var(--accent)]' : 'h-2 w-2 bg-[color:var(--ink-600)] hover:bg-[color:var(--paper-dim)] hover:scale-125'}"></button>`;
	}).join('');
	pageCount.textContent = totalPages > 1 ? `${currentPage + 1} / ${totalPages}` : '';
};

const renderCard = (project: PaginatorProject, globalIndex: number): string => {
	const key = `${globalIndex}`;
	const isOpen = expanded.has(key);
	const extra = project.achievements.slice(2);
	const techs = (project.technologies ?? []).slice(0, 6);
	const linkAttrs = project.link
		? isInternal(project.link)
			? `href="${esc(project.link)}"`
			: `href="${esc(project.link)}" target="_blank" rel="noopener noreferrer"`
		: '';

	return `
		<article class="relative flex flex-col gap-3 p-4 md:p-5 border ${isOpen ? 'border-[color:var(--accent)]/60' : 'border-[color:var(--ink-600)]'} rounded-xl bg-[color:var(--ink-850)] hover:border-[color:var(--accent)] hover:shadow-lg hover:shadow-[color:var(--accent)]/10 transition group/card h-full">
			<div class="flex items-start justify-between gap-2">
				<h3 class="text-lg font-bold text-[color:var(--paper)] group-hover/card:text-[color:var(--accent)] transition">
					${esc(project.title)}
				</h3>
				${project.link ? `
					<a ${linkAttrs} aria-label="Open ${esc(project.title)}" class="text-[color:var(--accent)] hover:text-[color:var(--paper)] transition flex-shrink-0 p-1 -m-1">
						<iconify-icon icon="mdi:open-in-new" class="text-xl"></iconify-icon>
					</a>
				` : ''}
			</div>
			<p class="text-xs font-semibold text-[color:var(--accent)]">${esc(project.role)}</p>
			<p class="text-xs text-[color:var(--paper-dim)] flex items-center gap-1">
				<iconify-icon icon="mdi:calendar-outline"></iconify-icon>
				${esc(project.period)}
			</p>
			<p class="text-sm text-[color:var(--paper-muted)] leading-relaxed">${esc(project.description)}</p>
			<ul class="flex flex-col gap-1.5 text-xs text-[color:var(--paper-muted)]">
				${project.achievements.slice(0, 2).map((a) => `
					<li class="flex gap-1.5">
						<iconify-icon icon="mdi:check" class="text-[color:var(--accent)] mt-0.5 flex-shrink-0"></iconify-icon>
						<span>${esc(a)}</span>
					</li>
				`).join('')}
				${isOpen ? extra.map((a) => `
					<li class="flex gap-1.5">
						<iconify-icon icon="mdi:check" class="text-[color:var(--accent)] mt-0.5 flex-shrink-0"></iconify-icon>
						<span>${esc(a)}</span>
					</li>
				`).join('') : ''}
			</ul>
			${techs.length > 0 ? `
				<div class="flex flex-wrap gap-1.5 mt-1">
					${techs.map((t) => `<span class="px-2 py-0.5 text-[11px] rounded-md bg-[color:var(--ink-800)] text-[color:var(--paper-dim)] border border-[color:var(--ink-600)]">${esc(t)}</span>`).join('')}
				</div>
			` : ''}
			${extra.length > 0 ? `
				<button type="button" data-expand="${globalIndex}" aria-expanded="${isOpen}" class="mt-auto self-start inline-flex items-center gap-1 text-xs font-semibold text-[color:var(--accent)] hover:text-[color:var(--paper)] transition cursor-pointer pt-2">
					<iconify-icon icon="${isOpen ? 'mdi:chevron-up' : 'mdi:chevron-down'}"></iconify-icon>
					${isOpen ? 'Show less' : `Show ${extra.length} more`}
				</button>
			` : '<span class="mt-auto"></span>'}
		</article>
	`;
};

function renderPage(direction = 0): void {
	if (isAnimating) return;
	isAnimating = true;

	const itemsPerPage = getItemsPerPage();
	const totalPages = Math.max(1, Math.ceil(projects.length / itemsPerPage));
	currentPage = Math.min(Math.max(0, currentPage), totalPages - 1);
	const start = currentPage * itemsPerPage;
	const pageProjects = projects.slice(start, start + itemsPerPage);

	const outX = direction > 0 ? -30 : 30;
	const inX = direction > 0 ? 30 : -30;

	const paint = (): void => {
		grid.innerHTML = pageProjects.map((p, i) => renderCard(p, start + i)).join('');
		renderPageDots(totalPages);
		prevBtn.disabled = currentPage === 0;
		nextBtn.disabled = currentPage >= totalPages - 1;
		isAnimating = false;
	};

	if (prefersReducedMotion || direction === 0) {
		// Initial paint + resize: quick fade only, no slide
		grid.style.transitionDuration = '0ms';
		grid.style.opacity = '0';
		grid.offsetHeight;
		paint();
		grid.style.transitionDuration = `${transitionMs}ms`;
		grid.style.opacity = '1';
		grid.style.transform = 'translateX(0) scale(1)';
		return;
	}

	grid.style.transitionDuration = `${transitionMs}ms`;
	grid.style.opacity = '0';
	grid.style.transform = `translateX(${outX}px) scale(0.985)`;

	window.setTimeout(() => {
		grid.innerHTML = pageProjects.map((p, i) => renderCard(p, start + i)).join('');

		grid.style.transitionDuration = '0ms';
		grid.style.opacity = '0';
		grid.style.transform = `translateX(${inX}px) scale(0.985)`;

		grid.offsetHeight;

		grid.style.transitionDuration = `${transitionMs}ms`;
		grid.style.opacity = '1';
		grid.style.transform = 'translateX(0) scale(1)';

		renderPageDots(totalPages);
		prevBtn.disabled = currentPage === 0;
		nextBtn.disabled = currentPage >= totalPages - 1;

		isAnimating = false;
	}, transitionMs);
}

const goTo = (page: number, direction?: number): void => {
	const itemsPerPage = getItemsPerPage();
	const totalPages = Math.max(1, Math.ceil(projects.length / itemsPerPage));
	const next = Math.min(Math.max(0, page), totalPages - 1);
	if (next === currentPage || isAnimating) return;
	const dir = direction ?? (next > currentPage ? 1 : -1);
	currentPage = next;
	renderPage(dir);
};

prevBtn.addEventListener('click', () => goTo(currentPage - 1, -1));
nextBtn.addEventListener('click', () => goTo(currentPage + 1, 1));

pageInfo.addEventListener('click', (e) => {
	const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-page]');
	if (!btn) return;
	goTo(Number(btn.dataset.page));
});

// Expand / collapse achievements (event delegation — survives re-renders)
grid.addEventListener('click', (e) => {
	const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-expand]');
	if (!btn) return;
	const key = btn.dataset.expand!;
	if (expanded.has(key)) expanded.delete(key);
	else expanded.add(key);
	// Re-render current page in place, no slide animation
	const itemsPerPage = getItemsPerPage();
	const start = currentPage * itemsPerPage;
	grid.innerHTML = projects.slice(start, start + itemsPerPage).map((p, i) => renderCard(p, start + i)).join('');
});

// Keyboard: left/right arrows when paginator focused
paginator.addEventListener('keydown', (e) => {
	if (e.key === 'ArrowLeft') goTo(currentPage - 1, -1);
	else if (e.key === 'ArrowRight') goTo(currentPage + 1, 1);
});

grid.addEventListener('touchstart', (event) => {
	const touch = event.changedTouches[0];
	touchStartX = touch.clientX;
	touchStartY = touch.clientY;
	touchStartTime = Date.now();
}, { passive: true });

grid.addEventListener('touchend', (event) => {
	if (isAnimating) return;

	const touch = event.changedTouches[0];
	const deltaX = touch.clientX - touchStartX;
	const deltaY = touch.clientY - touchStartY;
	const elapsedMs = Date.now() - touchStartTime;
	const totalPages = Math.max(1, Math.ceil(projects.length / getItemsPerPage()));

	const isHorizontalSwipe = Math.abs(deltaX) > 50 && Math.abs(deltaY) < 40 && elapsedMs < 650;
	if (!isHorizontalSwipe) return;

	if (deltaX < 0 && currentPage < totalPages - 1) {
		currentPage++;
		renderPage(1);
	}

	if (deltaX > 0 && currentPage > 0) {
		currentPage--;
		renderPage(-1);
	}
}, { passive: true });

let resizeTimer: ReturnType<typeof window.setTimeout> | undefined;
window.addEventListener('resize', () => {
	if (resizeTimer) {
		clearTimeout(resizeTimer);
	}
	resizeTimer = setTimeout(() => {
		currentPage = 0;
		renderPage(0);
	}, 250);
});

renderPage(0);
</script>
