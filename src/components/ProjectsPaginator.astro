---
import type { Project } from '../data/profile';

interface Props {
	projects: Project[];
}

const { projects } = Astro.props;
---

<div
	id="projects-paginator"
	class="space-y-6"
	data-projects={JSON.stringify(projects)}
>
	<div class="relative overflow-hidden rounded-3xl">
		<div
			id="projects-grid"
			class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 transition-all duration-500 ease-out"
			style="transform: translateX(0); opacity: 1;"
		>
			<!-- JS will fill this -->
		</div>

		<button
			id="prev-btn"
			aria-label="Previous projects page"
			class="absolute left-3 top-1/2 -translate-y-1/2 z-10 h-11 w-11 md:h-12 md:w-12 rounded-full border border-[color:var(--accent)] bg-[color:var(--accent)] text-[color:var(--paper)] hover:bg-[color:var(--accent-light)] hover:border-[color:var(--accent-light)] transition disabled:opacity-30 disabled:cursor-not-allowed flex items-center justify-center"
		>
			<iconify-icon icon="mdi:chevron-left" class="text-2xl"></iconify-icon>
		</button>

		<button
			id="next-btn"
			aria-label="Next projects page"
			class="absolute right-3 top-1/2 -translate-y-1/2 z-10 h-11 w-11 md:h-12 md:w-12 rounded-full border border-[color:var(--accent)] bg-[color:var(--accent)] text-[color:var(--paper)] hover:bg-[color:var(--accent-light)] hover:border-[color:var(--accent-light)] transition disabled:opacity-30 disabled:cursor-not-allowed flex items-center justify-center"
		>
			<iconify-icon icon="mdi:chevron-right" class="text-2xl"></iconify-icon>
		</button>
	</div>

	<div class="flex items-center justify-center pt-2 gap-4">
		<div id="page-info" class="flex items-center justify-center gap-2" aria-label="Project pages">
			<span class="h-2 w-2 rounded-full bg-[color:var(--accent)]"></span>
		</div>
	</div>
</div>

<script>
	const paginator = document.getElementById('projects-paginator') as HTMLElement;
	const grid = document.getElementById('projects-grid') as HTMLDivElement;
	const prevBtn = document.getElementById('prev-btn') as HTMLButtonElement;
	const nextBtn = document.getElementById('next-btn') as HTMLButtonElement;
	const pageInfo = document.getElementById('page-info') as HTMLElement;

	const projects = JSON.parse(paginator.dataset.projects || '[]') as Array<{
		title: string;
		role: string;
		period: string;
		description: string;
		link: string | null;
		achievements: string[];
	}>;
	let currentPage = 0;
	let isAnimating = false;
	let touchStartX = 0;
	let touchStartY = 0;
	let touchStartTime = 0;

	const getItemsPerPage = (): number => (window.innerWidth >= 1024 ? 3 : 2);
	const transitionMs = 320;
	const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	const renderPageDots = (totalPages: number): void => {
		pageInfo.innerHTML = Array.from({ length: totalPages }, (_, pageIndex) => {
			const dotClasses = pageIndex === currentPage
				? 'bg-[color:var(--accent)] scale-110'
				: 'bg-[color:var(--ink-600)]';

			return `<span class="h-2 w-2 rounded-full transition ${dotClasses}" aria-hidden="true"></span>`;
		}).join('');
	};

	const renderCard = (project: (typeof projects)[number]): string => `
		<div class="relative flex flex-col gap-3 p-4 md:p-5 border border-[color:var(--ink-600)] rounded-xl bg-[color:var(--ink-850)] hover:border-[color:var(--accent)] hover:shadow-lg hover:shadow-[color:var(--accent)]/10 transition group h-full">
			<div class="flex items-start justify-between gap-2">
				<h3 class="text-lg font-bold text-[color:var(--paper)] group-hover:text-[color:var(--accent)] transition">
					${project.title}
				</h3>
				${project.link ? `
					<a href="${project.link}" target="_blank" rel="noopener noreferrer" class="text-[color:var(--accent)] hover:text-[color:var(--paper)] transition">
						<iconify-icon icon="mdi:open-in-new" class="text-xl"></iconify-icon>
					</a>
				` : ''}
			</div>
			<p class="text-xs font-semibold text-[color:var(--accent)]">${project.role}</p>
			<p class="text-xs text-[color:var(--paper-dim)] flex items-center gap-1">
				<iconify-icon icon="mdi:calendar-outline"></iconify-icon>
				${project.period}
			</p>
			<p class="text-sm text-[color:var(--paper-muted)] leading-relaxed">${project.description}</p>
			<ul class="flex flex-col gap-1 text-xs text-[color:var(--paper-muted)] mt-auto">
				${project.achievements.slice(0, 2).map((achievement) => `
					<li class="flex gap-1">
						<iconify-icon icon="mdi:check" class="text-[color:var(--accent)] mt-0.5 flex-shrink-0"></iconify-icon>
						<span>${achievement}</span>
					</li>
				`).join('')}
			</ul>
		</div>
	`;

	function renderPage(direction = 0): void {
		if (isAnimating) return;
		isAnimating = true;

		const itemsPerPage = getItemsPerPage();
		const totalPages = Math.max(1, Math.ceil(projects.length / itemsPerPage));
		const start = currentPage * itemsPerPage;
		const pageProjects = projects.slice(start, start + itemsPerPage);

		const outX = direction > 0 ? -30 : 30;
		const inX = direction > 0 ? 30 : -30;

		if (prefersReducedMotion) {
			grid.innerHTML = pageProjects.map(renderCard).join('');
			renderPageDots(totalPages);
			prevBtn.disabled = currentPage === 0;
			nextBtn.disabled = currentPage >= totalPages - 1;
			isAnimating = false;
			return;
		}

		grid.style.transitionDuration = `${transitionMs}ms`;
		grid.style.opacity = '0';
		grid.style.transform = `translateX(${outX}px) scale(0.985)`;

		window.setTimeout(() => {
			grid.innerHTML = pageProjects.map(renderCard).join('');

			grid.style.transitionDuration = '0ms';
			grid.style.opacity = '0';
			grid.style.transform = `translateX(${inX}px) scale(0.985)`;

			grid.offsetHeight;

			grid.style.transitionDuration = `${transitionMs}ms`;
			grid.style.opacity = '1';
			grid.style.transform = 'translateX(0) scale(1)';

			renderPageDots(totalPages);
			prevBtn.disabled = currentPage === 0;
			nextBtn.disabled = currentPage >= totalPages - 1;

			isAnimating = false;
		}, transitionMs);
	}

	prevBtn.addEventListener('click', () => {
		if (currentPage > 0) {
			currentPage--;
			renderPage(-1);
		}
	});

	nextBtn.addEventListener('click', () => {
		const totalPages = Math.max(1, Math.ceil(projects.length / getItemsPerPage()));
		if (currentPage < totalPages - 1) {
			currentPage++;
			renderPage(1);
		}
	});

	grid.addEventListener('touchstart', (event) => {
		const touch = event.changedTouches[0];
		touchStartX = touch.clientX;
		touchStartY = touch.clientY;
		touchStartTime = Date.now();
	}, { passive: true });

	grid.addEventListener('touchend', (event) => {
		if (isAnimating) return;

		const touch = event.changedTouches[0];
		const deltaX = touch.clientX - touchStartX;
		const deltaY = touch.clientY - touchStartY;
		const elapsedMs = Date.now() - touchStartTime;
		const totalPages = Math.max(1, Math.ceil(projects.length / getItemsPerPage()));

		const isHorizontalSwipe = Math.abs(deltaX) > 50 && Math.abs(deltaY) < 40 && elapsedMs < 650;
		if (!isHorizontalSwipe) return;

		if (deltaX < 0 && currentPage < totalPages - 1) {
			currentPage++;
			renderPage(1);
		}

		if (deltaX > 0 && currentPage > 0) {
			currentPage--;
			renderPage(-1);
		}
	}, { passive: true });

	let resizeTimer: ReturnType<typeof window.setTimeout> | undefined;
	window.addEventListener('resize', () => {
		if (resizeTimer) {
			clearTimeout(resizeTimer);
		}
		resizeTimer = setTimeout(() => {
			currentPage = 0;
			renderPage(0);
		}, 250);
	});

	renderPage(0);
</script>