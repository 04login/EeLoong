---
import type { Project } from '../data/profile';

interface Props {
	projects: Project[];
}

const { projects } = Astro.props;
---

<div
	id="projects-paginator"
	class="space-y-6"
	data-projects={JSON.stringify(projects)}
>
	<div class="relative overflow-hidden rounded-3xl">
		<div
			id="projects-grid"
			class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 transition-all duration-500 ease-out"
			style="transform: translateX(0); opacity: 1;"
		>
			<!-- JS will fill this -->
		</div>
	</div>

	<div class="flex items-center justify-between pt-2 gap-4">
		<button
			id="prev-btn"
			class="flex items-center gap-2 px-6 py-3 rounded-2xl border border-[color:var(--ink-600)] hover:border-[color:var(--accent)] text-[color:var(--paper)] transition disabled:opacity-30 disabled:cursor-not-allowed"
		>
			<iconify-icon icon="mdi:chevron-left" class="text-2xl"></iconify-icon>
			Previous
		</button>

		<div id="page-info" class="font-medium text-sm text-[color:var(--paper-dim)] text-center">
			1 of 1
		</div>

		<button
			id="next-btn"
			class="flex items-center gap-2 px-6 py-3 rounded-2xl border border-[color:var(--ink-600)] hover:border-[color:var(--accent)] text-[color:var(--paper)] transition disabled:opacity-30 disabled:cursor-not-allowed"
		>
			Next
			<iconify-icon icon="mdi:chevron-right" class="text-2xl"></iconify-icon>
		</button>
	</div>
</div>

<script>
	const paginator = document.getElementById('projects-paginator') as HTMLElement;
	const grid = document.getElementById('projects-grid') as HTMLDivElement;
	const prevBtn = document.getElementById('prev-btn') as HTMLButtonElement;
	const nextBtn = document.getElementById('next-btn') as HTMLButtonElement;
	const pageInfo = document.getElementById('page-info') as HTMLElement;

	const projects = JSON.parse(paginator.dataset.projects || '[]') as Array<{
		title: string;
		role: string;
		period: string;
		description: string;
		link: string | null;
		achievements: string[];
	}>;
	let currentPage = 0;
	let isAnimating = false;

	const getItemsPerPage = (): number => (window.innerWidth >= 1024 ? 3 : 2);

	const renderCard = (project: (typeof projects)[number]): string => `
		<div class="relative flex flex-col gap-3 p-4 md:p-5 border border-[color:var(--ink-600)] rounded-xl bg-[color:var(--ink-850)] hover:border-[color:var(--accent)] hover:shadow-lg hover:shadow-[color:var(--accent)]/10 transition group h-full">
			<div class="flex items-start justify-between gap-2">
				<h3 class="text-lg font-bold text-[color:var(--paper)] group-hover:text-[color:var(--accent)] transition">
					${project.title}
				</h3>
				${project.link ? `
					<a href="${project.link}" target="_blank" rel="noopener noreferrer" class="text-[color:var(--accent)] hover:text-[color:var(--paper)] transition">
						<iconify-icon icon="mdi:open-in-new" class="text-xl"></iconify-icon>
					</a>
				` : ''}
			</div>
			<p class="text-xs font-semibold text-[color:var(--accent)]">${project.role}</p>
			<p class="text-xs text-[color:var(--paper-dim)] flex items-center gap-1">
				<iconify-icon icon="mdi:calendar-outline"></iconify-icon>
				${project.period}
			</p>
			<p class="text-sm text-[color:var(--paper-muted)] leading-relaxed">${project.description}</p>
			<ul class="flex flex-col gap-1 text-xs text-[color:var(--paper-muted)] mt-auto">
				${project.achievements.slice(0, 2).map((achievement) => `
					<li class="flex gap-1">
						<iconify-icon icon="mdi:check" class="text-[color:var(--accent)] mt-0.5 flex-shrink-0"></iconify-icon>
						<span>${achievement}</span>
					</li>
				`).join('')}
			</ul>
		</div>
	`;

	function renderPage(direction = 0): void {
		if (isAnimating) return;
		isAnimating = true;

		const itemsPerPage = getItemsPerPage();
		const totalPages = Math.max(1, Math.ceil(projects.length / itemsPerPage));
		const start = currentPage * itemsPerPage;
		const pageProjects = projects.slice(start, start + itemsPerPage);

		const slideOut = direction > 0 ? '-translate-x-8' : 'translate-x-8';
		grid.style.transitionDuration = '400ms';
		grid.style.opacity = '0';
		grid.style.transform = slideOut;

		window.setTimeout(() => {
			grid.innerHTML = pageProjects.map(renderCard).join('');

			const slideIn = direction > 0 ? 'translate-x-8' : '-translate-x-8';
			grid.style.transitionDuration = '0ms';
			grid.style.opacity = '0';
			grid.style.transform = slideIn;

			grid.offsetHeight;

			grid.style.transitionDuration = '400ms';
			grid.style.opacity = '1';
			grid.style.transform = 'translateX(0)';

			pageInfo.textContent = `${currentPage + 1} of ${totalPages}`;
			prevBtn.disabled = currentPage === 0;
			nextBtn.disabled = currentPage >= totalPages - 1;

			isAnimating = false;
		}, 400);
	}

	prevBtn.addEventListener('click', () => {
		if (currentPage > 0) {
			currentPage--;
			renderPage(-1);
		}
	});

	nextBtn.addEventListener('click', () => {
		const totalPages = Math.max(1, Math.ceil(projects.length / getItemsPerPage()));
		if (currentPage < totalPages - 1) {
			currentPage++;
			renderPage(1);
		}
	});

	let resizeTimer: ReturnType<typeof window.setTimeout> | undefined;
	window.addEventListener('resize', () => {
		if (resizeTimer) {
			clearTimeout(resizeTimer);
		}
		resizeTimer = setTimeout(() => {
			currentPage = 0;
			renderPage(0);
		}, 250);
	});

	renderPage(0);
</script>