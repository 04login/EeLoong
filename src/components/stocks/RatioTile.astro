---
// Valuation ratio tile (P/E, P/S, PEG, P/B, EPS) for the stock result page.
import { peSignal, psSignal, pbSignal, pegSignal, epsSignal, type RatioSignal } from "../../lib/stock-research/format.ts";
interface Props {
	label: string;
	value: string;
	source?: string | null;
	colorClass?: string;
}
const { label, value, source = null, colorClass = "" } = Astro.props;

// Determine which signal function to use based on the label
function getSignal(label: string, valueStr: string): RatioSignal {
	const val = parseFloat(valueStr);
	const num = isNaN(val) ? null : val;
	const l = label.toLowerCase();
	if (/\beps\b/i.test(l)) return epsSignal(num);
	if (/\bp\/?e\b/i.test(l)) return peSignal(num);
	if (/\bp\/?s\b/i.test(l)) return psSignal(num);
	if (/\bp\/?b\b/i.test(l)) return pbSignal(num);
	if (/\bpeg\b/i.test(l)) return pegSignal(num);
	// fallback to generic
	return { textClass: colorClass || "text-[color:var(--paper)]", badgeClass: "bg-[color:var(--ink-700)] text-[color:var(--paper-dim)]", label: "—", barPosition: 50, barColor: "gray" };
}

const signal = getSignal(label, value);

const isNA = signal.barColor === "gray";
// Full-spectrum gradient:
// For valuation ratios (P/E, P/S, PEG, P/B): Low is cheap/good (green at bottom), High is expensive (red at top).
// For inverted metrics (EPS): Low/negative is bad (red at bottom), High is profitable/good (green at top).
const barStyle = isNA
	? "background: linear-gradient(to top, var(--ink-700), var(--ink-500));"
	: signal.inverted
		? "background: linear-gradient(to top, var(--accent), var(--warning), var(--success));"
		: "background: linear-gradient(to top, var(--success), var(--warning), var(--accent));";

// Zone label for the pointer tag (left of bar)
const pointerLabel = signal.label && signal.label !== "—"
	? signal.label.toUpperCase()
	: signal.barColor === "green"
		? "LOW"
		: signal.barColor === "yellow"
			? "FAIR"
			: signal.barColor === "red"
				? "HIGH"
				: "N/A";
const pointerColors: Record<string, string> = {
	green: "bg-[color:var(--success)] text-white",
	yellow: "bg-[color:var(--warning)] text-[color:var(--ink-900)]",
	red: "bg-[color:var(--accent)] text-white",
	gray: "bg-[color:var(--ink-700)] text-[color:var(--paper-dim)]",
};
const pointerBg = pointerColors[signal.barColor] || "bg-[color:var(--ink-700)] text-[color:var(--paper-dim)]";
const valueColorClass = colorClass || signal.textClass;
---

<div class="bg-[color:var(--ink-900)] border border-[color:var(--ink-700)] rounded-lg p-4">
	<div class="flex items-center justify-between gap-4">
		<!-- Left: Ratio label and value -->
		<div class="flex-1 min-w-0">
			<p class="text-xs text-[color:var(--paper-dim)] uppercase tracking-wider mb-1">{label}</p>
			<p class={`text-2xl font-bold ${valueColorClass} truncate`}>{value}</p>
			{source && <p class="text-[10px] text-[color:var(--paper-muted)] mt-1 font-mono">{source}</p>}
		</div>

		<!-- Right: Vertical gradient bar with pointer tag on its LEFT -->
		<div class="flex items-center justify-center flex-shrink-0">
			<div class="relative flex items-center">
				<!-- Pointer tag on the LEFT of the bar -->
				<div class={`absolute right-full mr-2 ${pointerBg} px-2 py-1 rounded text-[10px] font-semibold uppercase tracking-wider whitespace-nowrap shadow-lg`} style={`bottom: ${signal.barPosition}%; transform: translateY(50%);`}>
					{pointerLabel}
				</div>

				<!-- Vertical gradient bar -->
				<div class="w-2.5 h-32 rounded-full overflow-hidden relative flex-shrink-0" style={barStyle}>
					<!-- White marker line on the bar -->
					<div class="absolute left-0 right-0 h-0.5 bg-white/90 shadow-[0_0_4px_rgba(0,0,0,0.6)]" style={`bottom: ${signal.barPosition}%;`}></div>
				</div>
			</div>
		</div>
	</div>
</div>
