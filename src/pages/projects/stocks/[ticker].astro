---
import "../../../styles/global.css";
import RatioTile from "../../../components/stocks/RatioTile.astro";
import StatTile from "../../../components/stocks/StatTile.astro";
import PhasePlaceholder from "../../../components/stocks/PhasePlaceholder.astro";
import LoadingPanel from "../../../components/stocks/LoadingPanel.astro";
import {
	lookupTicker,
	getPeerComparison,
	computeFairValue,
	PEER_GROUPS,
	type PeerComparison,
	type FairValue,
} from "../../../lib/stock-research/index.ts";
import { formatNumber, formatPercent, ratioClass, cur } from "../../../lib/stock-research/format.ts";

export const prerender = false;

const { ticker } = Astro.params;
if (!ticker) throw new Error("Missing ticker param");

const result = await lookupTicker(ticker);
const { quote, fundamentals, error } = result;
console.log("[stocks] lookupTicker:", ticker, JSON.stringify({ market: quote?.market, symbol: quote?.symbol, error }));

// Phase 2 + 3 (segment revenue, earnings audit) are NOT run here anymore —
// they need an EDGAR filing fetch + an LLM call, which made the first view of
// a ticker hang for ~10s and often render "unavailable". The page paints
// instantly with spinner cards and /panel (a partial route) is fetched
// client-side; its results cache in KV exactly as before.

// Phase 4 — peers + fair value (live, no cache). Only tickers with a curated
// peer set in config get these panels.
let peers: PeerComparison | null = null;
let fairValue: FairValue | null = null;
if (quote) {
	const peerSet = PEER_GROUPS[quote.symbol];
	console.log("[stocks] peer set:", quote.symbol, peerSet ? peerSet.join(",") : "none");
	if (peerSet) {
		try {
			peers = await getPeerComparison(quote.symbol, peerSet);
			console.log("[stocks] getPeerComparison:", peers?.peers.length ?? 0, "rows");
		} catch (e) {
			console.error("[stocks] getPeerComparison THREW:", e);
			peers = null;
		}
		if (peers) {
			fairValue = await computeFairValue(quote.symbol, peers, quote.epsTrailingTwelveMonths, quote.price);
			console.log("[stocks] fairValue:", JSON.stringify(fairValue));
		}
	}
}

// Shared formatting helpers moved to lib/stock-research/format.ts so the async
// panel partial renders identical numbers.
---

<html lang="en">
<head>
	<meta charset="utf-8" />
	<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	<meta name="viewport" content="width=device-width" />
	<title>{quote?.shortName ?? ticker.toUpperCase()} — Stock Research</title>
	<script is:inline type="module" src="https://cdn.jsdelivr.net/npm/iconify-icon@1/dist/iconify-icon.min.js"></script>
</head>
<body class="min-h-screen bg-[color:var(--ink-900)] text-[color:var(--paper)]">
	<main class="w-full max-w-[96%] xl:max-w-[90%] mx-auto pb-12 pt-4 md:pt-8 md:px-8">
		<!-- Header -->
		<div class="mb-6 flex flex-col md:flex-row md:items-center justify-between gap-4">
			<div>
				<h1 class="text-3xl font-bold text-[color:var(--paper)] flex items-center gap-3">
					<iconify-icon icon="mdi:chart-line" class="text-[color:var(--accent)] text-4xl"></iconify-icon>
					{quote?.shortName ?? ticker.toUpperCase()}
				</h1>
				<p class="text-[color:var(--paper-dim)] ml-11 text-sm">
					{quote?.longName ?? "—"} · {quote?.exchange ?? "—"} · {quote?.market ?? "—"}
				</p>
			</div>
			<a href="/projects/stocks" class="flex gap-2 items-center px-4 py-2 border border-[color:var(--ink-600)] bg-[color:var(--ink-850)] hover:bg-[color:var(--ink-800)] hover:border-[color:var(--accent)] rounded-lg text-sm transition font-semibold shadow-sm">
				<iconify-icon icon="mdi:arrow-left" class="text-lg text-[color:var(--accent)]"></iconify-icon>
				Back to Search
			</a>
		</div>

		{error && (
			<div class="mb-6 p-4 bg-[color:var(--ink-850)] border border-[color:var(--accent)]/30 rounded-lg text-[color:var(--accent)]">
				<strong>Could not load data for {ticker.toUpperCase()}.</strong>
				<p class="text-sm mt-1">Yahoo Finance may be blocking this region, the ticker may not exist, or the endpoint changed. Try again later.</p>
			</div>
		)}

		{!error && quote && (
			<>
				<!-- Price Header -->
				<div class="mb-8 bg-[color:var(--ink-850)] border border-[color:var(--ink-600)] rounded-xl p-6 shadow-sm">
					<div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
						<div>
							<p class="text-[color:var(--paper-dim)] text-xs font-semibold uppercase tracking-wider mb-1">Price</p>
							<p class="text-4xl font-bold text-[color:var(--paper)]">
								{cur(quote.currency)}{formatNumber(quote.price, 2)}
							</p>
						</div>
						<div class="flex items-end gap-4 text-right md:text-left">
							<div>
								<p class="text-[color:var(--paper-dim)] text-xs font-semibold uppercase tracking-wider mb-1">Change</p>
								<p class={`text-lg font-semibold ${quote.change !== null && quote.change >= 0 ? "text-green-400" : "text-red-400"}`}>
									{quote.change !== null ? (quote.change >= 0 ? "+" : "") + formatNumber(quote.change, 2) : "—"}
								</p>
							</div>
							<div>
								<p class="text-[color:var(--paper-dim)] text-xs font-semibold uppercase tracking-wider mb-1">Change %</p>
								<p class={`text-lg font-semibold ${quote.changePercent !== null && quote.changePercent >= 0 ? "text-green-400" : "text-red-400"}`}>
									{quote.changePercent !== null ? formatPercent(quote.changePercent) : "—"}
								</p>
							</div>
						</div>
					</div>
					<div class="mt-4 flex flex-wrap gap-6 text-sm text-[color:var(--paper-dim)] border-t border-[color:var(--ink-700)] pt-4">
						<div><span class="font-semibold text-[color:var(--paper)]">{formatNumber(quote.previousClose, 2)}</span> Prev Close</div>
						<div><span class="font-semibold text-[color:var(--paper)]">{formatNumber(quote.dayLow, 2)} – {formatNumber(quote.dayHigh, 2)}</span> Day Range</div>
						<div><span class="font-semibold text-[color:var(--paper)]">{formatNumber(quote.fiftyTwoWeekLow, 2)} – {formatNumber(quote.fiftyTwoWeekHigh, 2)}</span> 52-Week Range</div>
						<div><span class="font-semibold text-[color:var(--paper)]">{formatNumber(quote.volume)}</span> Volume</div>
						<div><span class="font-semibold text-[color:var(--paper)]">{formatNumber(quote.marketCap)}</span> Market Cap</div>
					</div>
				</div>

				<!-- Fundamentals Card -->
				{fundamentals && (
					<div class="mb-8 bg-[color:var(--ink-850)] border border-[color:var(--ink-600)] rounded-xl p-6 shadow-sm">
						<div class="flex justify-between items-start mb-5">
							<h2 class="text-xl font-bold text-[color:var(--paper)] flex items-center gap-2">
								<iconify-icon icon="mdi:calculator-variant" class="text-[color:var(--accent)] text-2xl"></iconify-icon>
								Valuation Ratios
								<button
									class="text-[color:var(--paper-dim)] hover:text-[color:var(--accent)] focus:outline-none rounded-lg p-1"
									aria-label="What are Valuation Ratios?"
								onclick="toggleExplanation('valuation')"
								>
										<iconify-icon icon="mdi:information-outline" class="text-1xl text-[color:var(--accent)]"></iconify-icon>
									</button>
							</h2>
						</div>

						<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
							<RatioTile
								label="P/E (TTM)"
								value={fundamentals.pe !== null ? fundamentals.pe.toFixed(2) : "—"}
								source={fundamentals.peSource}
								colorClass={ratioClass(fundamentals.pe)}
							/>
							<RatioTile
								label="P/S (TTM)"
								value={fundamentals.ps !== null ? fundamentals.ps.toFixed(2) : "—"}
								colorClass={ratioClass(fundamentals.ps)}
							/>
							<RatioTile
								label="PEG"
								value={fundamentals.peg !== null ? fundamentals.peg.toFixed(2) : "—"}
								colorClass={ratioClass(fundamentals.peg)}
							/>
							<RatioTile
								label="P/B"
								value={quote.priceToBook !== null ? quote.priceToBook.toFixed(2) : "—"}
								colorClass={ratioClass(quote.priceToBook)}
							/>
						</div>

						<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-sm">
							<StatTile label="EPS (TTM)" value={formatNumber(quote.epsTrailingTwelveMonths, 2)} />
							<StatTile label="EPS (Fwd)" value={formatNumber(quote.epsForward, 2)} />
							<StatTile label="Revenue (TTM)" value={formatNumber(quote.revenueTrailingTwelveMonths)} />
							<StatTile label="Earnings Growth" value={formatPercent(quote.earningsGrowth)} />
						</div>

						{fundamentals.peSource === "computed" && (
							<p class="mt-4 text-xs text-[color:var(--paper-muted)] italic">
								⚠ P/E was computed (price ÷ EPS) because Yahoo did not report a trailing PE for this ticker.
							</p>
						)}
					</div>
				)}

				<!-- Segment Revenue + Earnings Audit — loaded async via /panel (US filings only) -->
				{quote?.market === "US" ? (
					<div id="stock-panels" class="contents" data-ticker={encodeURIComponent(quote.symbol)}>
						<LoadingPanel
							title="Segment Revenue"
							icon="mdi:chart-pie"
							description="Extracting segment revenue from the latest 10-K (SEC EDGAR)…"
						/>
						<LoadingPanel
							title="Earnings Audit"
							icon="mdi:file-document-edit"
							description="Scanning the filing for one-off items and asking the model to label them…"
						/>
					</div>
				) : (
					<>
						<PhasePlaceholder
							title="Segment Revenue Breakdown"
							icon="mdi:chart-pie"
							description="Segment data is US-only for now — SEC filings don't cover SGX/HK listings."
							badge="Phase 2"
							helpKey="segments"
						/>
						<PhasePlaceholder
							title="Earnings Audit"
							icon="mdi:file-document-edit"
							description="Filing audit is US-only for now — SEC filings don't cover SGX/HK listings."
							badge="Phase 3"
							helpKey="audit"
						/>
					</>
				)}

				<!-- Peer Comparison (Phase 4) -->
				{peers && peers.peers.length > 0 && (
					<div class="mb-8 bg-[color:var(--ink-850)] border border-[color:var(--ink-600)] rounded-xl p-6 shadow-sm">
						<div class="flex items-center justify-between gap-4 mb-5">
							<h2 class="text-xl font-bold text-[color:var(--paper)] flex items-center gap-2">
								<iconify-icon icon="mdi:account-group" class="text-[color:var(--accent)] text-2xl"></iconify-icon>
								Peer Comparison
								<button
									class="text-[color:var(--paper-dim)] hover:text-[color:var(--accent)] focus:outline-none rounded-lg p-1"
									aria-label="What is Peer Comparison?"
								onclick="toggleExplanation('peers')"
								>
										<iconify-icon icon="mdi:information-outline" class="text-1xl text-[color:var(--accent)]"></iconify-icon>
									</button>
							</h2>
							<span class="text-xs text-[color:var(--paper-dim)]">{peers.peers.length} peers · live</span>
						</div>

						<div class="overflow-x-auto">
							<table class="w-full text-sm">
								<thead>
									<tr class="text-left text-xs font-semibold text-[color:var(--paper-dim)] uppercase tracking-wider border-b border-[color:var(--ink-600)]">
										<th class="py-2 pr-4">Peer</th>
										<th class="py-2 pr-4">P/E</th>
										<th class="py-2 pr-4">P/S</th>
										<th class="py-2 pr-4">PEG</th>
									</tr>
								</thead>
								<tbody class="divide-y divide-[color:var(--ink-700)]">
									{peers.peers.map((p) => (
										<tr>
											<td class="py-2 pr-4">
												<span class="font-mono font-semibold text-[color:var(--accent)]">{p.ticker}</span>
												<span class="ml-2 text-[color:var(--paper-dim)] hidden md:inline">{p.shortName}</span>
											</td>
											<td class="py-2 pr-4 font-mono">{p.pe !== null ? p.pe.toFixed(1) : "—"}</td>
											<td class="py-2 pr-4 font-mono">{p.ps !== null ? p.ps.toFixed(1) : "—"}</td>
											<td class="py-2 pr-4 font-mono">{p.peg !== null ? p.peg.toFixed(2) : "—"}</td>
										</tr>
									))}
									<tr class="font-semibold border-t-2 border-t-[color:var(--ink-600)]">
										<td class="py-2 pr-4 text-[color:var(--paper)]">Peer average</td>
										<td class="py-2 pr-4 font-mono text-[color:var(--accent)]">{peers.averages.pe !== null ? peers.averages.pe.toFixed(1) : "—"}</td>
										<td class="py-2 pr-4 font-mono text-[color:var(--accent)]">{peers.averages.ps !== null ? peers.averages.ps.toFixed(1) : "—"}</td>
										<td class="py-2 pr-4 font-mono text-[color:var(--accent)]">{peers.averages.peg !== null ? peers.averages.peg.toFixed(2) : "—"}</td>
									</tr>
								</tbody>
							</table>
						</div>
					</div>
				)}
				{!peers && (
					<PhasePlaceholder
						title="Peer Comparison"
						icon="mdi:account-group"
						description="No curated peer set for this ticker yet — comparison covers well-known names only for now."
						badge="Phase 4"
					/>
				)}
				{peers && peers.peers.length === 0 && (
					<PhasePlaceholder
						title="Peer Comparison"
						icon="mdi:account-group"
						description={peers.unavailableNote ?? "Peer data unavailable right now."}
						badge="Phase 4"
					/>
				)}

				<!-- Fair Value (Phase 4) -->
				{fairValue && (
					<div class="mb-8 bg-[color:var(--ink-850)] border border-[color:var(--ink-600)] rounded-xl p-6 shadow-sm">
						<div class="flex items-center justify-between gap-4 mb-5">
							<h2 class="text-xl font-bold text-[color:var(--paper)] flex items-center gap-2">
								<iconify-icon icon="mdi:gauge" class="text-[color:var(--accent)] text-2xl"></iconify-icon>
								Fair Value
								<button
									class="text-[color:var(--paper-dim)] hover:text-[color:var(--accent)] focus:outline-none rounded-lg p-1"
									aria-label="What is Fair Value Band?"
								onclick="toggleExplanation('fairvalue')"
								>
										<iconify-icon icon="mdi:information-outline" class="text-1xl text-[color:var(--accent)]"></iconify-icon>
									</button>
							</h2>
							<span class="text-xs text-[color:var(--paper-dim)]">{fairValue.formula}</span>
						</div>

						<div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
							<div>
								<p class="text-[color:var(--paper-dim)] text-xs font-semibold uppercase tracking-wider mb-1">Implied price</p>
								<p class="text-4xl font-bold text-[color:var(--paper)]">
									{cur(quote.currency)}{formatNumber(fairValue.impliedPrice, 2)}
								</p>
							</div>
							<div class="text-right">
								<p class="text-[color:var(--paper-dim)] text-xs font-semibold uppercase tracking-wider mb-1">vs market price</p>
								<p class={`text-4xl font-bold ${fairValue.vsPrice !== null && fairValue.vsPrice > 0 ? "text-green-400" : "text-red-400"}`}>
									{fairValue.vsPrice !== null ? formatPercent(fairValue.vsPrice) : "—"}
								</p>
							</div>
						</div>

						<div class="mt-4 grid grid-cols-3 gap-4 text-sm border-t border-[color:var(--ink-700)] pt-4">
							<div><span class="font-semibold text-[color:var(--paper)]">{cur(quote.currency)}{formatNumber(fairValue.low, 2)}</span> Band low</div>
							<div><span class="font-semibold text-[color:var(--accent)]">{cur(quote.currency)}{formatNumber(fairValue.impliedPrice, 2)}</span> Implied</div>
							<div><span class="font-semibold text-[color:var(--paper)]">{cur(quote.currency)}{formatNumber(fairValue.high, 2)}</span> Band high</div>
						</div>

						<p class="mt-4 text-xs text-[color:var(--paper-muted)] italic">
							Inputs: peer-avg P/E {formatNumber(fairValue.peerPe, 1)} × EPS {formatNumber(fairValue.eps, 2)} · market price {cur(quote.currency)}{formatNumber(quote.price, 2)}
						</p>
					</div>
				)}
				{peers && peers.peers.length > 0 && !fairValue && (
								<PhasePlaceholder
									title="Fair Value Band"
									icon="mdi:gauge"
									description="Needs a peer-average P/E and positive EPS to compute an implied price."
									badge="Phase 4"
								/>
							)}

							<!-- Explanation Section -->
							<div class="mb-8">
								<!-- Compact help/question buttons (replaces full <details> cards) -->
<div class="mb-8 flex flex-wrap gap-3 pt-4 border-t border-[color:var(--ink-700)]">
  <button
    class="flex items-center gap-2 text-[color:var(--paper-dim)] hover:text-[color:var(--paper)] transition-colors hover:bg-[color:var(--ink-900)] border border-[color:var(--ink-700)] rounded-lg px-3 py-1 text-sm focus:outline-none focus:bg-[color:var(--ink-850)]"
    aria-label="What is Valuation Ratios?"
    onclick="toggleExplanation('valuation')"
  >
    <iconify-icon icon="mdi:calculator-variant" class="text-[color:var(--accent)] text-xs"></iconify-icon>
    <span>Valuation Ratios</span>
  </button>
  <button
    class="flex items-center gap-2 text-[color:var(--paper-dim)] hover:text-[color:var(--paper)] transition-colors hover:bg-[color:var(--ink-900)] border border-[color:var(--ink-700)] rounded-lg px-3 py-1 text-sm focus:outline-none focus:bg-[color:var(--ink-850)]"
    aria-label="What is Segment Revenue Breakdown?"
    onclick="toggleExplanation('segments')"
  >
    <iconify-icon icon="mdi:chart-pie" class="text-[color:var(--accent)] text-xs"></iconify-icon>
    <span>Segment Revenue</span>
  </button>
  <button
    class="flex items-center gap-2 text-[color:var(--paper-dim)] hover:text-[color:var(--paper)] transition-colors hover:bg-[color:var(--ink-900)] border border-[color:var(--ink-700)] rounded-lg px-3 py-1 text-sm focus:outline-none focus:bg-[color:var(--ink-850)]"
    aria-label="What is Earnings Audit?"
    onclick="toggleExplanation('audit')"
  >
    <iconify-icon icon="mdi:file-document-edit" class="text-[color:var(--accent)] text-xs"></iconify-icon>
    <span>Earnings Audit</span>
  </button>
  <button
    class="flex items-center gap-2 text-[color:var(--paper-dim)] hover:text-[color:var(--paper)] transition-colors hover:bg-[color:var(--ink-900)] border border-[color:var(--ink-700)] rounded-lg px-3 py-1 text-sm focus:outline-none focus:bg-[color:var(--ink-850)]"
    aria-label="What is Peer Comparison?"
    onclick="toggleExplanation('peers')"
  >
    <iconify-icon icon="mdi:account-group" class="text-[color:var(--accent)] text-xs"></iconify-icon>
    <span>Peer Comparison</span>
  </button>
  <button
    class="flex items-center gap-2 text-[color:var(--paper-dim)] hover:text-[color:var(--paper)] transition-colors hover:bg-[color:var(--ink-900)] border border-[color:var(--ink-700)] rounded-lg px-3 py-1 text-sm focus:outline-none focus:bg-[color:var(--ink-850)]"
    aria-label="What is Fair Value Band?"
    onclick="toggleExplanation('fairvalue')"
  >
    <iconify-icon icon="mdi:gauge" class="text-[color:var(--accent)] text-xs"></iconify-icon>
    <span>Fair Value</span>
  </button>
</div>

<!-- Valuation Ratios Explanation -->
<div id="explanation-valuation" class="absolute right-6 top-full bg-[color:var(--ink-850)] border border-[color:var(--ink-600)] rounded-xl p-4 shadow-lg w-72 text-sm text-[color:var(--paper)] z-50 hidden" role="dialog" aria-modal="true">
  <div class="flex justify-between items-start mb-4">
    <h3 class="font-semibold text-[color:var(--paper)]">Valuation Ratios</h3>
    <button class="text-[color:var(--paper-dim)] hover:text-[color:var(--accent)] focus:outline-none" aria-label="Close explanation" onclick="document.getElementById('explanation-valuation').classList.add('hidden')">
      <iconify-icon icon="mdi:close" class="text-2xl"></iconify-icon>
    </button>
  </div>
  <ul class="space-y-2">
    <li class="flex gap-2"><span class="w-1 h-1 rounded bg-[color:var(--accent)]"></span>These ratios tell you <strong>how expensive or cheap a stock looks</strong> relative to its earnings, sales, assets, or growth. They're quick filters — not final verdicts.</li>
    <li class="flex gap-2"><span class="w-1 h-1 rounded bg-[color:var(--accent)]"></span>Each ratio tile below shows a <strong>gradient bar</strong>: green = cheap/attractive zone, yellow = fair/reasonable, red = expensive. The white marker shows where this stock sits.</li>
  </ul>
  <div class="mt-4 overflow-x-auto">
    <table class="w-full text-xs border border-[color:var(--ink-700)] rounded-lg overflow-hidden">
      <thead>
        <tr class="bg-[color:var(--ink-900)] text-left text-[color:var(--paper-dim)] font-semibold uppercase tracking-wider border-b border-[color:var(--ink-700)]">
          <th class="p-3">Ratio</th><th class="p-3">Low (Green)</th><th class="p-3">Mid / Fair (Yellow)</th><th class="p-3">High (Red)</th><th class="p-3">Context & Practical Rules</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-[color:var(--ink-700)]">
        <tr class="bg-[color:var(--ink-900)]"><td class="p-3 font-mono font-semibold text-[color:var(--paper)]">P/E (Price-to-Earnings)</td><td class="p-3 text-green-400">< 12–15</td><td class="p-3 text-yellow-300">15 – 25</td><td class="p-3 text-red-400">> 25–30+</td><td class="p-3 text-[color:var(--paper-muted)]">Historical S&P 500 average ~18–22. High P/E is typical for tech/growth; low P/E common for mature banks, energy, utilities.</td></tr>
        <tr class="bg-[color:var(--ink-850)]"><td class="p-3 font-mono font-semibold text-[color:var(--paper)]">PEG (P/E ÷ Growth Rate)</td><td class="p-3 text-green-400">< 1.0</td><td class="p-3 text-yellow-300">1.0 – 1.5</td><td class="p-3 text-red-400">> 2.0</td><td class="p-3 text-[color:var(--paper-muted)]">Adjusts P/E for earnings growth. PEG < 1 suggests undervalued relative to growth; > 2 suggests overvaluation. Only meaningful with positive growth.</td></tr>
        <tr class="bg-[color:var(--ink-900)]"><td class="p-3 font-mono font-semibold text-[color:var(--paper)]">P/B (Price-to-Book)</td><td class="p-3 text-green-400">< 1.0</td><td class="p-3 text-yellow-300">1.0 – 3.0</td><td class="p-3 text-red-400">> 3.0–5.0+</td><td class="p-3 text-[color:var(--paper-muted)]">Compares price to net assets (book value). < 1 = buying under liquidation value (common in distressed/financials). Asset-light tech often > 10.</td></tr>
        <tr class="bg-[color:var(--ink-850)]"><td class="p-3 font-mono font-semibold text-[color:var(--paper)]">P/S (Price-to-Sales)</td><td class="p-3 text-green-400">< 1–2</td><td class="p-3 text-yellow-300">2 – 4</td><td class="p-3 text-red-400">> 6–10+</td><td class="p-3 text-[color:var(--paper-muted)]">Used for unprofitable growth or high-margin software. Low P/S = cheap revenue; high P/S = paying premium for growth/margins.</td></tr>
      </tbody>
    </table>
  </div>
</div>

<!-- Segment Revenue Explanation -->
<div id="explanation-segments" class="absolute right-6 top-full bg-[color:var(--ink-850)] border border-[color:var(--ink-600)] rounded-xl p-4 shadow-lg w-72 text-sm text-[color:var(--paper)] z-50 hidden" role="dialog" aria-modal="true">
  <div class="flex justify-between items-start mb-4">
    <h3 class="font-semibold text-[color:var(--paper)]">Segment Revenue Breakdown</h3>
    <button class="text-[color:var(--paper-dim)] hover:text-[color:var(--accent)] focus:outline-none" aria-label="Close explanation" onclick="document.getElementById('explanation-segments').classList.add('hidden')">
      <iconify-icon icon="mdi:close" class="text-2xl"></iconify-icon>
    </button>
  </div>
  <ul class="space-y-2">
    <li class="flex gap-2"><span class="w-1 h-1 rounded bg-[color:var(--accent)]"></span>Shows where the money actually comes from — product lines, business units, or geographies — pulled from the company's latest SEC filing (10-K annual or 10-Q quarterly).</li>
    <li class="flex gap-2"><span class="w-1 h-1 rounded bg-[color:var(--accent)]"></span>Each coloured bar is one slice of the revenue pie. The label (e.g. 'iPhone', 'Services', 'Americas') comes from the filing; the length shows that segment's share of total revenue.</li>
    <li class="flex gap-2"><span class="w-1 h-1 rounded bg-[color:var(--accent)]"></span>Data source: the XBRL (machine-readable) version of the filing. If that's missing or messy, we fall back to the HTML tables in the segment note. An LLM cleans up the raw labels but never invents numbers.</li>
    <li class="flex gap-2"><span class="w-1 h-1 rounded bg-[color:var(--accent)]"></span>If the latest filing is a quarterly 10-Q, the numbers cover the year-to-date period (e.g. first half of the year), not a full year. The period date is shown at the top of the panel.</li>
  </ul>
</div>

<!-- Earnings Audit Explanation -->
<div id="explanation-audit" class="absolute right-6 top-full bg-[color:var(--ink-850)] border border-[color:var(--ink-600)] rounded-xl p-4 shadow-lg w-72 text-sm text-[color:var(--paper)] z-50 hidden" role="dialog" aria-modal="true">
  <div class="flex justify-between items-start mb-4">
    <h3 class="font-semibold text-[color:var(--paper)]">Earnings Audit</h3>
    <button class="text-[color:var(--paper-dim)] hover:text-[color:var(--accent)] focus:outline-none" aria-label="Close explanation" onclick="document.getElementById('explanation-audit').classList.add('hidden')">
      <iconify-icon icon="mdi:close" class="text-2xl"></iconify-icon>
    </button>
  </div>
  <ul class="space-y-2">
    <li class="flex gap-2"><span class="w-1 h-1 rounded bg-[color:var(--accent)]"></span>Compares reported EPS (what the company announced) with adjusted EPS (what profit looks like after removing one-off items).</li>
    <li class="flex gap-2"><span class="w-1 h-1 rounded bg-[color:var(--accent)]"></span>One-off items are things like: asset write-downs, restructuring costs, legal settlements, gains/losses from selling a division — stuff that probably won't repeat next year.</li>
    <li class="flex gap-2"><span class="w-1 h-1 rounded bg-[color:var(--accent)]"></span>We scan the SEC filing for accounting tags that signal one-offs, then ask an LLM to decide which are truly non-recurring and label them CHARGE (hurt earnings) or GAIN (helped earnings). The LLM never does math — it only labels.</li>
    <li class="flex gap-2"><span class="w-1 h-1 rounded bg-[color:var(--accent)]"></span>Adjusted EPS = Reported EPS − (Total one-off impact ÷ Share count). Adjusted P/E and PEG use this cleaner earnings number. If no material one-offs are found, the panel says so honestly.</li>
  </ul>
</div>

<!-- Peer Comparison Explanation -->
<div id="explanation-peers" class="absolute right-6 top-full bg-[color:var(--ink-850)] border border-[color:var(--ink-600)] rounded-xl p-4 shadow-lg w-72 text-sm text-[color:var(--paper)] z-50 hidden" role="dialog" aria-modal="true">
  <div class="flex justify-between items-start mb-4">
    <h3 class="font-semibold text-[color:var(--paper)]">Peer Comparison</h3>
    <button class="text-[color:var(--paper-dim)] hover:text-[color:var(--accent)] focus:outline-none" aria-label="Close explanation" onclick="document.getElementById('explanation-peers').classList.add('hidden')">
      <iconify-icon icon="mdi:close" class="text-2xl"></iconify-icon>
    </button>
  </div>
  <ul class="space-y-2">
    <li class="flex gap-2"><span class="w-1 h-1 rounded bg-[color:var(--accent)]"></span>Shows the same valuation ratios (P/E, P/S, PEG) for a handful of <strong>hand-picked companies in the same sector</strong> — not an algorithmic list, just well-known names that investors usually compare.</li>
    <li class="flex gap-2"><span class="w-1 h-1 rounded bg-[color:var(--accent)]"></span>The 'Peer average' row is the simple average of the peers that returned valid data. It's the benchmark used for the Fair Value calculation below.</li>
    <li class="flex gap-2"><span class="w-1 h-1 rounded bg-[color:var(--accent)]"></span>If a peer's data is missing or nonsense (e.g. negative P/E), it's dropped from the average. Tickers without a curated peer group show 'not available' rather than a random list.</li>
  </ul>
</div>

<!-- Fair Value Explanation -->
<div id="explanation-fairvalue" class="absolute right-6 top-full bg-[color:var(--ink-850)] border border-[color:var(--ink-600)] rounded-xl p-4 shadow-lg w-72 text-sm text-[color:var(--paper)] z-50 hidden" role="dialog" aria-modal="true">
  <div class="flex justify-between items-start mb-4">
    <h3 class="font-semibold text-[color:var(--paper)]">Fair Value Band</h3>
    <button class="text-[color:var(--paper-dim)] hover:text-[color:var(--accent)] focus:outline-none" aria-label="Close explanation" onclick="document.getElementById('explanation-fairvalue').classList.add('hidden')">
      <iconify-icon icon="mdi:close" class="text-2xl"></iconify-icon>
    </button>
  </div>
  <ul class="space-y-2">
    <li class="flex gap-2"><span class="w-1 h-1 rounded bg-[color:var(--accent)]"></span>A <strong>rough price target range</strong> based on: (Peer average P/E) × (This company's EPS) ± 20%.</li>
    <li class="flex gap-2"><span class="w-1 h-1 rounded bg-[color:var(--accent)]"></span>The logic: if peers trade at 20× earnings and this company earns $5/share, implied fair value = 20 × $5 = $100. The band is $80–$120 (±20%).</li>
    <li class="flex gap-2"><span class="w-1 h-1 rounded bg-[color:var(--accent)]"></span>This is <strong>not a prediction</strong> — it's a sanity check. It assumes the company deserves the same multiple as its peers. Real fair value depends on growth, margins, balance sheet, moat, etc., which this simple formula ignores.</li>
    <li class="flex gap-2"><span class="w-1 h-1 rounded bg-[color:var(--accent)]"></span>Only appears when we have a peer average P/E and positive EPS. If either is missing, the panel doesn't show.</li>
  </ul>
</div>

<script>
function toggleExplanation(key) {
  const panel = document.getElementById(`explanation-${key}`);
  if (panel.classList.contains('hidden')) {
    panel.classList.remove('hidden');
  } else {
    panel.classList.add('hidden');
  }
}
</script>
							</div>
						</>
					)}
				</main>

	<script>
		// Async panels: replace the two spinner cards with the /panel fragment
		// (segment revenue + earnings audit, run server-side after first paint).
		// Fire-and-forget — the page is fully usable without it. A timeout keeps
		// a hung LLM call from spinning forever; it can't just hide the spinners,
		// because a timed-out request often DID populate the KV cache server-side
		// — a refresh then loads instantly from cache.
		//
		// DEBUGGING: every step logs to the browser console with a [stocks:client]
		// prefix, and the /panel response's X-Stocks-Debug header (present when
		// STOCK_DEBUG is enabled server-side) is dumped here too — so the whole
		// server-side pipeline is readable from Chrome DevTools.
		const host = document.getElementById("stock-panels");
		const tickerParam = host?.dataset.ticker;
		if (host && tickerParam) {
			console.log(`[stocks:client] panel fetch starting for ${tickerParam}`);
			const startedAt = performance.now();
			const ctrl = new AbortController();
			const timer = setTimeout(() => ctrl.abort(), 75_000);
			fetch(`/projects/stocks/${tickerParam}/panel`, { headers: { Accept: "text/html" }, signal: ctrl.signal })
				.then((res) => {
					const ms = Math.round(performance.now() - startedAt);
					const dbg = res.headers.get("X-Stocks-Debug");
					if (dbg) {
						console.groupCollapsed("[stocks:client] server trace (X-Stocks-Debug)");
						dbg.split(" | ").forEach((line) => console.log(line));
						console.groupEnd();
					} else {
						console.log("[stocks:client] no X-Stocks-Debug header (STOCK_DEBUG off server-side)");
					}
					console.log(`[stocks:client] panel response ${res.status} in ${ms}ms`);
					return res.ok ? res.text() : Promise.reject(new Error(String(res.status)));
				})
				.then((html) => {
					clearTimeout(timer);
					// Log what actually arrived — placeholders mean the SERVER decided
					// the data was unavailable (not a fetch failure).
					const isPlaceholder = html.includes("No segment revenue available") || html.includes("One-off item identification unavailable");
					const hasSegmentPanel = html.includes("Segment Revenue");
					const hasAuditPanel = html.includes("Earnings Audit");
					console.log(`[stocks:client] fragment: segmentPanel=${hasSegmentPanel && !isPlaceholder ? "yes" : isPlaceholder ? "placeholder" : "no"} · auditPanel=${html.includes("No material one-off") || !html.includes("One-off item identification unavailable") ? "see trace" : "placeholder"} · ${(html.length / 1024).toFixed(1)}KB`);
					host.innerHTML = html;
					console.log(`[stocks:client] panels swapped in at ${Math.round(performance.now() - startedAt)}ms total`);
				})
				.catch((err) => {
					clearTimeout(timer);
					console.error(`[stocks:client] panel fetch FAILED:`, err?.name === "AbortError" ? `aborted at ~75s (server still processing — a refresh often loads instantly from KV)` : err);
					host.innerHTML = `
						<div class="bg-[color:var(--ink-850)] border border-[color:var(--ink-700)] border-dashed rounded-xl p-5 mb-8">
							<h3 class="font-semibold text-[color:var(--paper-dim)]">Segment Revenue &amp; Earnings Audit</h3>
							<p class="text-sm text-[color:var(--paper-muted)] mt-1">
								Couldn't load the filing panels in time — the data source was slow, not necessarily empty.
								<a href="javascript:location.reload()" class="text-[color:var(--accent)] underline">Refresh</a> to retry; a partially-completed load is usually cached.
							</p>
						</div>`;
				});
		} else {
			console.log("[stocks:client] no #stock-panels host — panels section not rendered (non-US market or quote failed)");
		}
	</script>
</body>
</html>
