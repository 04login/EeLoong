---
import "../../../styles/global.css";
import RatioTile from "../../../components/stocks/RatioTile.astro";
import StatTile from "../../../components/stocks/StatTile.astro";
import PhasePlaceholder from "../../../components/stocks/PhasePlaceholder.astro";
import LoadingPanel from "../../../components/stocks/LoadingPanel.astro";
import {
	lookupTicker,
	getPeerComparison,
	computeFairValue,
	PEER_GROUPS,
	type PeerComparison,
	type FairValue,
} from "../../../lib/stock-research/index.ts";
import { formatNumber, formatPercent, ratioClass, cur } from "../../../lib/stock-research/format.ts";

export const prerender = false;

const { ticker } = Astro.params;
if (!ticker) throw new Error("Missing ticker param");

const result = await lookupTicker(ticker);
const { quote, fundamentals, error } = result;
console.log("[stocks] lookupTicker:", ticker, JSON.stringify({ market: quote?.market, symbol: quote?.symbol, error }));

// Phase 2 + 3 (segment revenue, earnings audit) are NOT run here anymore —
// they need an EDGAR filing fetch + an LLM call, which made the first view of
// a ticker hang for ~10s and often render "unavailable". The page paints
// instantly with spinner cards and /panel (a partial route) is fetched
// client-side; its results cache in KV exactly as before.

// Phase 4 — peers + fair value (live, no cache). Only tickers with a curated
// peer set in config get these panels.
let peers: PeerComparison | null = null;
let fairValue: FairValue | null = null;
if (quote) {
	const peerSet = PEER_GROUPS[quote.symbol];
	console.log("[stocks] peer set:", quote.symbol, peerSet ? peerSet.join(",") : "none");
	if (peerSet) {
		try {
			peers = await getPeerComparison(quote.symbol, peerSet);
			console.log("[stocks] getPeerComparison:", peers?.peers.length ?? 0, "rows");
		} catch (e) {
			console.error("[stocks] getPeerComparison THREW:", e);
			peers = null;
		}
		if (peers) {
			fairValue = await computeFairValue(quote.symbol, peers, quote.epsTrailingTwelveMonths, quote.price);
			console.log("[stocks] fairValue:", JSON.stringify(fairValue));
		}
	}
}

// Shared formatting helpers moved to lib/stock-research/format.ts so the async
// panel partial renders identical numbers.
---

<html lang="en">
<head>
	<meta charset="utf-8" />
	<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	<meta name="viewport" content="width=device-width" />
	<title>{quote?.shortName ?? ticker.toUpperCase()} — Stock Research</title>
	<script is:inline type="module" src="https://cdn.jsdelivr.net/npm/iconify-icon@1/dist/iconify-icon.min.js"></script>
</head>
<body class="min-h-screen bg-[color:var(--ink-900)] text-[color:var(--paper)]">
	<main class="w-full max-w-[96%] xl:max-w-[90%] mx-auto pb-12 pt-4 md:pt-8 md:px-8">
		<!-- Header -->
		<div class="mb-6 flex flex-col md:flex-row md:items-center justify-between gap-4">
			<div>
				<h1 class="text-3xl font-bold text-[color:var(--paper)] flex items-center gap-3">
					<iconify-icon icon="mdi:chart-line" class="text-[color:var(--accent)] text-4xl"></iconify-icon>
					{quote?.shortName ?? ticker.toUpperCase()}
				</h1>
				<p class="text-[color:var(--paper-dim)] ml-11 text-sm">
					{quote?.longName ?? "—"} · {quote?.exchange ?? "—"} · {quote?.market ?? "—"}
				</p>
			</div>
			<a href="/projects/stocks" class="flex gap-2 items-center px-4 py-2 border border-[color:var(--ink-600)] bg-[color:var(--ink-850)] hover:bg-[color:var(--ink-800)] hover:border-[color:var(--accent)] rounded-lg text-sm transition font-semibold shadow-sm">
				<iconify-icon icon="mdi:arrow-left" class="text-lg text-[color:var(--accent)]"></iconify-icon>
				Back to Search
			</a>
		</div>

		{error && (
			<div class="mb-6 p-4 bg-[color:var(--ink-850)] border border-[color:var(--accent)]/30 rounded-lg text-[color:var(--accent)]">
				<strong>Could not load data for {ticker.toUpperCase()}.</strong>
				<p class="text-sm mt-1">Yahoo Finance may be blocking this region, the ticker may not exist, or the endpoint changed. Try again later.</p>
			</div>
		)}

		{!error && quote && (
			<>
				<!-- Price Header -->
				<div class="mb-8 bg-[color:var(--ink-850)] border border-[color:var(--ink-600)] rounded-xl p-6 shadow-sm">
					<div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
						<div>
							<p class="text-[color:var(--paper-dim)] text-xs font-semibold uppercase tracking-wider mb-1">Price</p>
							<p class="text-4xl font-bold text-[color:var(--paper)]">
								{cur(quote.currency)}{formatNumber(quote.price, 2)}
							</p>
						</div>
						<div class="flex items-end gap-4 text-right md:text-left">
							<div>
								<p class="text-[color:var(--paper-dim)] text-xs font-semibold uppercase tracking-wider mb-1">Change</p>
								<p class={`text-lg font-semibold ${quote.change !== null && quote.change >= 0 ? "text-green-400" : "text-red-400"}`}>
									{quote.change !== null ? (quote.change >= 0 ? "+" : "") + formatNumber(quote.change, 2) : "—"}
								</p>
							</div>
							<div>
								<p class="text-[color:var(--paper-dim)] text-xs font-semibold uppercase tracking-wider mb-1">Change %</p>
								<p class={`text-lg font-semibold ${quote.changePercent !== null && quote.changePercent >= 0 ? "text-green-400" : "text-red-400"}`}>
									{quote.changePercent !== null ? formatPercent(quote.changePercent) : "—"}
								</p>
							</div>
						</div>
					</div>
					<div class="mt-4 flex flex-wrap gap-6 text-sm text-[color:var(--paper-dim)] border-t border-[color:var(--ink-700)] pt-4">
						<div><span class="font-semibold text-[color:var(--paper)]">{formatNumber(quote.previousClose, 2)}</span> Prev Close</div>
						<div><span class="font-semibold text-[color:var(--paper)]">{formatNumber(quote.dayLow, 2)} – {formatNumber(quote.dayHigh, 2)}</span> Day Range</div>
						<div><span class="font-semibold text-[color:var(--paper)]">{formatNumber(quote.fiftyTwoWeekLow, 2)} – {formatNumber(quote.fiftyTwoWeekHigh, 2)}</span> 52-Week Range</div>
						<div><span class="font-semibold text-[color:var(--paper)]">{formatNumber(quote.volume)}</span> Volume</div>
						<div><span class="font-semibold text-[color:var(--paper)]">{formatNumber(quote.marketCap)}</span> Market Cap</div>
					</div>
				</div>

				<!-- Fundamentals Card -->
				{fundamentals && (
					<div class="mb-8 bg-[color:var(--ink-850)] border border-[color:var(--ink-600)] rounded-xl p-6 shadow-sm">
						<h2 class="text-xl font-bold text-[color:var(--paper)] flex items-center gap-2 mb-5">
							<iconify-icon icon="mdi:calculator-variant" class="text-[color:var(--accent)] text-2xl"></iconify-icon>
							Valuation Ratios
						</h2>

						<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
							<RatioTile
								label="P/E (TTM)"
								value={fundamentals.pe !== null ? fundamentals.pe.toFixed(2) : "—"}
								source={fundamentals.peSource}
								colorClass={ratioClass(fundamentals.pe)}
							/>
							<RatioTile
								label="P/S (TTM)"
								value={fundamentals.ps !== null ? fundamentals.ps.toFixed(2) : "—"}
								colorClass={ratioClass(fundamentals.ps)}
							/>
							<RatioTile
								label="PEG"
								value={fundamentals.peg !== null ? fundamentals.peg.toFixed(2) : "—"}
								colorClass={ratioClass(fundamentals.peg)}
							/>
							<RatioTile
								label="P/B"
								value={quote.priceToBook !== null ? quote.priceToBook.toFixed(2) : "—"}
								colorClass={ratioClass(quote.priceToBook)}
							/>
						</div>

						<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-sm">
							<StatTile label="EPS (TTM)" value={formatNumber(quote.epsTrailingTwelveMonths, 2)} />
							<StatTile label="EPS (Fwd)" value={formatNumber(quote.epsForward, 2)} />
							<StatTile label="Revenue (TTM)" value={formatNumber(quote.revenueTrailingTwelveMonths)} />
							<StatTile label="Earnings Growth" value={formatPercent(quote.earningsGrowth)} />
						</div>

						{fundamentals.peSource === "computed" && (
							<p class="mt-4 text-xs text-[color:var(--paper-muted)] italic">
								⚠ P/E was computed (price ÷ EPS) because Yahoo did not report a trailing PE for this ticker.
							</p>
						)}
					</div>
				)}

				<!-- Segment Revenue + Earnings Audit — loaded async via /panel (US filings only) -->
				{quote?.market === "US" ? (
					<div id="stock-panels" class="contents" data-ticker={encodeURIComponent(quote.symbol)}>
						<LoadingPanel
							title="Segment Revenue"
							icon="mdi:chart-pie"
							description="Extracting segment revenue from the latest 10-K (SEC EDGAR)…"
						/>
						<LoadingPanel
							title="Earnings Audit"
							icon="mdi:file-document-edit"
							description="Scanning the filing for one-off items and asking the model to label them…"
						/>
					</div>
				) : (
					<>
						<PhasePlaceholder
							title="Segment Revenue Breakdown"
							icon="mdi:chart-pie"
							description="Segment data is US-only for now — SEC filings don't cover SGX/HK listings."
							badge="Phase 2"
						/>
						<PhasePlaceholder
							title="Earnings Audit"
							icon="mdi:file-document-edit"
							description="Filing audit is US-only for now — SEC filings don't cover SGX/HK listings."
							badge="Phase 3"
						/>
					</>
				)}

				<!-- Peer Comparison (Phase 4) -->
				{peers && peers.peers.length > 0 && (
					<div class="mb-8 bg-[color:var(--ink-850)] border border-[color:var(--ink-600)] rounded-xl p-6 shadow-sm">
						<div class="flex items-center justify-between gap-4 mb-5">
							<h2 class="text-xl font-bold text-[color:var(--paper)] flex items-center gap-2">
								<iconify-icon icon="mdi:account-group" class="text-[color:var(--accent)] text-2xl"></iconify-icon>
								Peer Comparison
							</h2>
							<span class="text-xs text-[color:var(--paper-dim)]">{peers.peers.length} peers · live</span>
						</div>

						<div class="overflow-x-auto">
							<table class="w-full text-sm">
								<thead>
									<tr class="text-left text-xs font-semibold text-[color:var(--paper-dim)] uppercase tracking-wider border-b border-[color:var(--ink-600)]">
										<th class="py-2 pr-4">Peer</th>
										<th class="py-2 pr-4">P/E</th>
										<th class="py-2 pr-4">P/S</th>
										<th class="py-2 pr-4">PEG</th>
									</tr>
								</thead>
								<tbody class="divide-y divide-[color:var(--ink-700)]">
									{peers.peers.map((p) => (
										<tr>
											<td class="py-2 pr-4">
												<span class="font-mono font-semibold text-[color:var(--accent)]">{p.ticker}</span>
												<span class="ml-2 text-[color:var(--paper-dim)] hidden md:inline">{p.shortName}</span>
											</td>
											<td class="py-2 pr-4 font-mono">{p.pe !== null ? p.pe.toFixed(1) : "—"}</td>
											<td class="py-2 pr-4 font-mono">{p.ps !== null ? p.ps.toFixed(1) : "—"}</td>
											<td class="py-2 pr-4 font-mono">{p.peg !== null ? p.peg.toFixed(2) : "—"}</td>
										</tr>
									))}
									<tr class="font-semibold border-t-2 border-t-[color:var(--ink-600)]">
										<td class="py-2 pr-4 text-[color:var(--paper)]">Peer average</td>
										<td class="py-2 pr-4 font-mono text-[color:var(--accent)]">{peers.averages.pe !== null ? peers.averages.pe.toFixed(1) : "—"}</td>
										<td class="py-2 pr-4 font-mono text-[color:var(--accent)]">{peers.averages.ps !== null ? peers.averages.ps.toFixed(1) : "—"}</td>
										<td class="py-2 pr-4 font-mono text-[color:var(--accent)]">{peers.averages.peg !== null ? peers.averages.peg.toFixed(2) : "—"}</td>
									</tr>
								</tbody>
							</table>
						</div>
					</div>
				)}
				{!peers && (
					<PhasePlaceholder
						title="Peer Comparison"
						icon="mdi:account-group"
						description="No curated peer set for this ticker yet — comparison covers well-known names only for now."
						badge="Phase 4"
					/>
				)}
				{peers && peers.peers.length === 0 && (
					<PhasePlaceholder
						title="Peer Comparison"
						icon="mdi:account-group"
						description={peers.unavailableNote ?? "Peer data unavailable right now."}
						badge="Phase 4"
					/>
				)}

				<!-- Fair Value (Phase 4) -->
				{fairValue && (
					<div class="mb-8 bg-[color:var(--ink-850)] border border-[color:var(--ink-600)] rounded-xl p-6 shadow-sm">
						<div class="flex items-center justify-between gap-4 mb-5">
							<h2 class="text-xl font-bold text-[color:var(--paper)] flex items-center gap-2">
								<iconify-icon icon="mdi:gauge" class="text-[color:var(--accent)] text-2xl"></iconify-icon>
								Fair Value
							</h2>
							<span class="text-xs text-[color:var(--paper-dim)]">{fairValue.formula}</span>
						</div>

						<div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
							<div>
								<p class="text-[color:var(--paper-dim)] text-xs font-semibold uppercase tracking-wider mb-1">Implied price</p>
								<p class="text-4xl font-bold text-[color:var(--paper)]">
									{cur(quote.currency)}{formatNumber(fairValue.impliedPrice, 2)}
								</p>
							</div>
							<div class="text-right">
								<p class="text-[color:var(--paper-dim)] text-xs font-semibold uppercase tracking-wider mb-1">vs market price</p>
								<p class={`text-4xl font-bold ${fairValue.vsPrice !== null && fairValue.vsPrice > 0 ? "text-green-400" : "text-red-400"}`}>
									{fairValue.vsPrice !== null ? formatPercent(fairValue.vsPrice) : "—"}
								</p>
							</div>
						</div>

						<div class="mt-4 grid grid-cols-3 gap-4 text-sm border-t border-[color:var(--ink-700)] pt-4">
							<div><span class="font-semibold text-[color:var(--paper)]">{cur(quote.currency)}{formatNumber(fairValue.low, 2)}</span> Band low</div>
							<div><span class="font-semibold text-[color:var(--accent)]">{cur(quote.currency)}{formatNumber(fairValue.impliedPrice, 2)}</span> Implied</div>
							<div><span class="font-semibold text-[color:var(--paper)]">{cur(quote.currency)}{formatNumber(fairValue.high, 2)}</span> Band high</div>
						</div>

						<p class="mt-4 text-xs text-[color:var(--paper-muted)] italic">
							Inputs: peer-avg P/E {formatNumber(fairValue.peerPe, 1)} × EPS {formatNumber(fairValue.eps, 2)} · market price {cur(quote.currency)}{formatNumber(quote.price, 2)}
						</p>
					</div>
				)}
				{peers && peers.peers.length > 0 && !fairValue && (
					<PhasePlaceholder
						title="Fair Value Band"
						icon="mdi:gauge"
						description="Needs a peer-average P/E and positive EPS to compute an implied price."
						badge="Phase 4"
					/>
				)}
			</>
		)}
	</main>

	<script>
		// Async panels: replace the two spinner cards with the /panel fragment
		// (segment revenue + earnings audit, run server-side after first paint).
		// Fire-and-forget — the page is fully usable without it.
		const host = document.getElementById("stock-panels");
		const tickerParam = host?.dataset.ticker;
		if (host && tickerParam) {
			fetch(`/projects/stocks/${tickerParam}/panel`, { headers: { Accept: "text/html" } })
				.then((res) => (res.ok ? res.text() : Promise.reject(new Error(String(res.status)))))
				.then((html) => {
					host.innerHTML = html;
				})
				.catch(() => {
					host.innerHTML = `
						<div class="bg-[color:var(--ink-850)] border border-[color:var(--ink-700)] border-dashed rounded-xl p-5 mb-8">
							<h3 class="font-semibold text-[color:var(--paper-dim)]">Segment Revenue &amp; Earnings Audit</h3>
							<p class="text-sm text-[color:var(--paper-muted)] mt-1">Couldn't load the filing panels — refresh to retry.</p>
						</div>`;
				});
		}
	</script>
</body>
</html>
