---
import "../../styles/global.css";

// Ensure this is SSR
export const prerender = false;

let db = Astro.locals?.runtime?.env?.DB;

let deals = [];
let searches = [];

// Handle URL parameters for filtering
const url = new URL(Astro.request.url);
const filterSearchId = url.searchParams.get("search_id") || "all";
const textQuery = url.searchParams.get("q") || "";
const sortOption = url.searchParams.get("sort") || "score_desc";

if (db) {
    // 1. Fetch available searches for the dropdown filter
    const searchesResult = await db.prepare("SELECT search_id, name FROM monitored_searches ORDER BY name ASC").all();
    if (searchesResult.results) {
        searches = searchesResult.results;
    }

	// 2. Build the query dynamically based on filters
    let queryArgs = [];
    let whereClauses = ["a.deal_score > 0", "l.is_active = TRUE"];

    if (filterSearchId !== "all") {
        whereClauses.push("l.search_id = ?");
        queryArgs.push(filterSearchId);
    }
    
    if (textQuery) {
        whereClauses.push("(l.title LIKE ? OR l.description LIKE ?)");
        queryArgs.push(`%${textQuery}%`);
        queryArgs.push(`%${textQuery}%`);
    }

    const whereSql = whereClauses.length > 0 ? `WHERE ${whereClauses.join(' AND ')}` : "";

    // Determine the ORDER BY clause
    let orderBySql = "ORDER BY a.deal_score DESC";
    if (sortOption === "date_desc") orderBySql = "ORDER BY l.listed_at DESC";
    else if (sortOption === "date_asc") orderBySql = "ORDER BY l.listed_at ASC";
    else if (sortOption === "price_asc") orderBySql = "ORDER BY l.price_sgd ASC";
    else if (sortOption === "price_desc") orderBySql = "ORDER BY l.price_sgd DESC";

	const query = `
		SELECT 
			l.listing_id,
			l.title,
			l.price_sgd,
			l.description,
			l.url,
            l.listed_at,
            l.seller,
            s.name as search_name,
			a.total_intrinsic_value,
			a.deal_score,
			a.llm_reasoning,
            a.components
		FROM listings l
		JOIN listing_analysis a ON l.listing_id = a.listing_id
        LEFT JOIN monitored_searches s ON l.search_id = s.search_id
		${whereSql}
		${orderBySql}
	`;

    // 3. Execute the custom statement
    let statement = db.prepare(query);
    if (queryArgs.length > 0) {
        statement = statement.bind(...queryArgs);
    }

	const result = await statement.all();
	if (result.results) {
		deals = result.results;
	}
}

if (!db && import.meta.env.DEV) {
	deals = [
		{
			listing_id: "mock1",
			title: "Mock Deal: Asus TUF RTX 3080 10GB",
			price_sgd: 350,
			total_intrinsic_value: 520,
			deal_score: 32.6,
			llm_reasoning: "Great entry level 3080 deal, no signs of mining. Seller seems reputable with good reviews base.",
			url: "https://carousell.sg/mock",
            description: "Used for around 2 years strictly for gaming. Never mined. Comes with original box. Selling because I upgraded.",
            listed_at: new Date().toISOString(),
            seller: "mock_gamer99",
            search_name: "RTX 3080",
            components: "Asus TUF RTX 3080 10GB"
		},
	];
}

// Quick helper to format dates beautifully
const formatDate = (dateStr: string) => {
    if (!dateStr) return "Unknown";
    const date = new Date(dateStr);
    return date.toLocaleDateString("en-SG", {
        month: "short",
        day: "numeric",
        hour: "2-digit",
        minute: "2-digit"
    });
};
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<title>Carousell Deals Dashboard</title>
		<script type="module" src="https://cdn.jsdelivr.net/npm/iconify-icon@1/dist/iconify-icon.min.js"></script>
        <style>
            /* Smooth accordion/details opening */
            details > summary { list-style: none; }
            details > summary::-webkit-details-marker { display: none; }
            details[open] summary ~ * { animation: sweep .3s ease-in-out; }
            @keyframes sweep {
                0% { opacity: 0; margin-top: -10px; }
                100% { opacity: 1; margin-top: 0px; }
            }
        </style>
	</head>
	<body class="min-h-screen bg-[color:var(--ink-900)] text-[color:var(--paper)]">
		<main class="max-w-6xl mx-auto p-4 md:p-8">
			<!-- Header -->
            <div class="mb-6 flex flex-col md:flex-row md:items-center justify-between gap-4">
				<div>
					<h1 class="text-3xl font-bold text-[color:var(--paper)] flex items-center gap-3">
                        <iconify-icon icon="mdi:robot-excited-outline" class="text-[color:var(--accent)] text-4xl"></iconify-icon>
                        Deal Monitor
                    </h1>
					<p class="text-[color:var(--paper-dim)] ml-1">AI-driven intrinsic value tracking</p>
				</div>
				<a href="/projects/carousell-bot/searches" class="flex gap-2 items-center px-4 py-2 border border-[color:var(--ink-600)] bg-[color:var(--ink-850)] hover:bg-[color:var(--ink-800)] hover:border-[color:var(--accent)] rounded-lg text-sm transition font-semibold shadow-sm">
					<iconify-icon icon="mdi:cog" class="text-lg text-[color:var(--accent)]"></iconify-icon>
					Settings
				</a>
			</div>

            <!-- Filters Bar -->
            <div class="bg-[color:var(--ink-850)] border border-[color:var(--ink-600)] rounded-xl p-4 mb-8 shadow-sm">
                <form method="GET" class="flex flex-col md:flex-row gap-4 items-end">
                    <div class="w-full md:w-auto flex-grow">
                        <label for="q" class="block text-[color:var(--paper-dim)] text-xs font-semibold uppercase tracking-wider mb-1.5 ml-0.5">Search Title/Desc</label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                <iconify-icon icon="mdi:magnify" class="text-[color:var(--paper-muted)]"></iconify-icon>
                            </div>
                            <input type="text" id="q" name="q" value={textQuery} placeholder="Filter keywords..." class="w-full bg-[color:var(--ink-900)] border border-[color:var(--ink-700)] rounded-md pl-10 pr-3 py-2 text-sm text-[color:var(--paper)] focus:outline-none focus:border-[color:var(--accent)] transition">
                        </div>
                    </div>
                    
                    <div class="w-full md:w-auto min-w-[200px]">
                        <label for="search_id" class="block text-[color:var(--paper-dim)] text-xs font-semibold uppercase tracking-wider mb-1.5 ml-0.5">Category</label>
                        <select id="search_id" name="search_id" class="w-full bg-[color:var(--ink-900)] border border-[color:var(--ink-700)] rounded-md px-3 py-2 text-sm text-[color:var(--paper)] focus:outline-none focus:border-[color:var(--accent)] transition appearance-none cursor-pointer">
                            <option value="all" selected={filterSearchId === "all"}>All Categories</option>
                            {searches.map(s => (
                                <option value={s.search_id} selected={filterSearchId == s.search_id} key={s.search_id}>{s.name}</option>
                            ))}
                        </select>
                    </div>

                    <div class="w-full md:w-auto min-w-[170px]">
                        <label for="sort" class="block text-[color:var(--paper-dim)] text-xs font-semibold uppercase tracking-wider mb-1.5 ml-0.5">Sort By</label>
                        <select id="sort" name="sort" class="w-full bg-[color:var(--ink-900)] border border-[color:var(--ink-700)] rounded-md px-3 py-2 text-sm text-[color:var(--paper)] focus:outline-none focus:border-[color:var(--accent)] transition appearance-none cursor-pointer">
                            <option value="score_desc" selected={sortOption === "score_desc"}>Highest Deal Score</option>
                            <option value="date_desc" selected={sortOption === "date_desc"}>Newest First</option>
                            <option value="date_asc" selected={sortOption === "date_asc"}>Oldest First</option>
                            <option value="price_asc" selected={sortOption === "price_asc"}>Price: Low to High</option>
                            <option value="price_desc" selected={sortOption === "price_desc"}>Price: High to Low</option>
                        </select>
                    </div>

                    <div class="w-full md:w-auto flex gap-2">
                        <button type="submit" class="flex-grow md:flex-grow-0 bg-[color:var(--accent)] hover:bg-[color:var(--accent-light)] text-gray-900 font-bold py-2 px-6 rounded-md transition duration-200 shadow-sm flex items-center justify-center gap-2">
                            Apply
                        </button>
                        {(filterSearchId !== "all" || textQuery !== "" || sortOption !== "score_desc") && (
                            <a href="/projects/carousell-bot" class="flex-grow md:flex-grow-0 bg-[color:var(--ink-700)] hover:bg-[color:var(--ink-600)] text-[color:var(--paper)] font-semibold py-2 px-4 rounded-md transition duration-200 flex items-center justify-center text-sm" title="Clear Filters">
                                <iconify-icon icon="mdi:close"></iconify-icon>
                            </a>
                        )}
                    </div>
                </form>
            </div>
			
			<div class="space-y-6">
				{deals.length === 0 ? (
					<div class="text-center py-16 border border-[color:var(--ink-700)] border-dashed rounded-2xl bg-[color:var(--ink-850)]/50">
                        <iconify-icon icon="mdi:folder-search-outline" class="text-5xl text-[color:var(--ink-600)] mb-3"></iconify-icon>
                        <h3 class="text-xl font-bold text-[color:var(--paper-dim)]">No valid deals found</h3>
                        <p class="text-[color:var(--paper-muted)] mt-2 text-sm">Try adjusting your filters or checking back later after the bot runs.</p>
                    </div>
				) : (
					<div class="grid grid-cols-1 xl:grid-cols-2 gap-6 items-start">
						{deals.map((deal) => (
							<div class="relative flex flex-col border border-[color:var(--ink-600)] rounded-xl bg-[color:var(--ink-900)] overflow-hidden shadow-sm hover:border-[color:var(--accent)]/50 hover:shadow-[color:var(--accent)]/5 transition-all duration-300">
								
                                <div class="bg-[color:var(--ink-850)] px-5 py-4 border-b border-[color:var(--ink-700)]">
                                    <div class="flex justify-between items-start gap-3 mb-2">
                                        <div class="flex flex-col items-start gap-1">
                                            {deal.search_name && (
                                                <span class="text-[10px] font-bold uppercase tracking-wider text-[color:var(--paper-muted)] bg-[color:var(--ink-900)] border border-[color:var(--ink-700)] px-2 py-0.5 rounded">
                                                    {deal.search_name}
                                                </span>
                                            )}
                                        </div>
                                        <div class="bg-gradient-to-r from-green-500/20 to-[color:var(--accent)]/20 text-green-300 border border-green-500/30 px-2.5 py-1 rounded text-sm font-black whitespace-nowrap shadow-sm flex items-center gap-1">
                                            <iconify-icon icon="mdi:fire" class="text-green-400"></iconify-icon>
                                            +{deal.deal_score.toFixed(1)}%
                                        </div>
                                    </div>
                                    <h2 class="text-[1.05rem] leading-snug font-bold text-[color:var(--paper)] mt-1" title={deal.title}>
                                        {deal.title}
                                    </h2>
                                </div>
								
								<div class="px-5 py-4 flex flex-col sm:flex-row justify-between items-start sm:items-end border-b border-[color:var(--ink-700)] gap-4 sm:gap-2">
									<div>
										<p class="text-[10px] uppercase font-bold text-[color:var(--paper-dim)] mb-0.5 tracking-wide">Asking Price</p>
										<p class="text-2xl font-black text-white drop-shadow-sm">
											S${deal.price_sgd.toFixed(2)}
										</p>
									</div>
                                    <div class="hidden sm:block border-l-2 border-[color:var(--ink-700)] border-dashed h-8 mx-2"></div>
									<div class="text-left sm:text-right">
										<p class="text-[10px] uppercase font-bold text-[color:var(--paper-dim)] mb-0.5 tracking-wide">Est. Value (Intrinsic)</p>
										<p class="text-lg font-bold text-[color:var(--paper-muted)] line-through decoration-[color:var(--ink-500)] decoration-2">
											S${deal.total_intrinsic_value.toFixed(2)}
										</p>
									</div>
								</div>

								<div class="px-5 py-4 bg-[color:var(--ink-900)]">
									<p class="text-[11px] uppercase font-black text-[color:var(--accent)] mb-1.5 flex items-center gap-1.5">
										<iconify-icon icon="mdi:brain" class="text-sm"></iconify-icon>
										Bot Analysis
									</p>
									<p class="text-[13px] text-[color:var(--paper-dim)] leading-relaxed italic border-l-2 border-[color:var(--accent)]/40 pl-3">
										"{deal.llm_reasoning}"
									</p>
								</div>
								
                                <details class="group border-t border-[color:var(--ink-700)] bg-[color:var(--ink-850)]/50">
                                    <summary class="px-5 py-3 text-xs font-bold text-[color:var(--paper-muted)] group-hover:bg-[color:var(--ink-800)] group-hover:text-[color:var(--paper)] flex items-center justify-between cursor-pointer transition select-none">
                                        <span class="flex items-center gap-2">
                                            <iconify-icon icon="mdi:information-outline" class="text-base"></iconify-icon>
                                            View Full Details
                                        </span>
                                        <iconify-icon icon="mdi:chevron-down" class="text-lg transition-transform duration-300 group-open:rotate-180"></iconify-icon>
                                    </summary>

                                    <div class="px-5 pb-5 pt-1 text-[13px] space-y-4">
                                        <div class="grid grid-cols-2 gap-3 p-3 bg-[color:var(--ink-900)] rounded-lg border border-[color:var(--ink-700)]">
                                            <div>
                                                <p class="text-[10px] uppercase font-bold text-[color:var(--paper-muted)] mb-0.5">Posted Date</p>
                                                <p class="font-mono text-xs text-[color:var(--paper)] flex items-center gap-1 truncate">
                                                    <iconify-icon icon="mdi:clock-time-four-outline" class="text-[color:var(--paper-dim)]"></iconify-icon>
                                                    {formatDate(deal.listed_at)}
                                                </p>
                                            </div>
                                            <div>
                                                <p class="text-[10px] uppercase font-bold text-[color:var(--paper-muted)] mb-0.5">Seller</p>
                                                <p class="font-mono text-xs text-[color:var(--paper)] flex items-center gap-1 truncate" title={deal.seller}>
                                                    <iconify-icon icon="mdi:account-outline" class="text-[color:var(--paper-dim)]"></iconify-icon>
                                                    {deal.seller || "Unknown"}
                                                </p>
                                            </div>
                                        </div>

                                        {deal.components && (deal.components.trim() !== "") && (
                                            <div>
                                                <p class="text-[10px] uppercase font-bold text-[color:var(--paper-muted)] mb-1">Identified Components</p>
                                                <div class="bg-[color:var(--ink-900)] border border-[color:var(--ink-700)] rounded-lg p-2.5 font-mono text-xs text-[color:var(--accent)]/80 break-words whitespace-pre-wrap">
                                                    {deal.components}
                                                </div>
                                            </div>
                                        )}

                                        <div>
                                            <p class="text-[10px] uppercase font-bold text-[color:var(--paper-muted)] mb-1 flex items-center gap-1">
                                                <iconify-icon icon="mdi:text-box-outline"></iconify-icon>
                                                Raw Description
                                            </p>
                                            <div class="bg-[color:var(--ink-900)] border border-[color:var(--ink-700)] rounded-lg p-3 text-[color:var(--paper-dim)] whitespace-pre-wrap max-h-48 overflow-y-auto text-xs leading-relaxed custom-scrollbar">
                                                {deal.description || "No description provided."}
                                            </div>
                                        </div>
                                    </div>
                                </details>

								<div class="bg-[color:var(--ink-900)] border-t border-[color:var(--ink-700)]">
									<a href={deal.url} target="_blank" rel="noopener noreferrer" class="flex justify-center items-center gap-2 w-full py-3.5 bg-[color:var(--ink-800)] hover:bg-[color:var(--accent)] hover:text-black transition-all text-sm font-bold shadow-sm rounded-b-[10px]">
										View on Carousell
                                        <iconify-icon icon="mdi:arrow-top-right" class="text-lg"></iconify-icon>
									</a>
								</div>
							</div>
						))}
					</div>
				)}
			</div>
		</main>
	</body>
</html>