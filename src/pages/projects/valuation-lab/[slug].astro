---
import "../../../styles/global.css";
import { env } from "cloudflare:workers";
import { getModel } from "../../../lib/stock-research/sotp/store.ts";
import { computeTotals } from "../../../lib/stock-research/sotp/model.ts";
import { cur, formatNumber, formatPrice } from "../../../lib/stock-research/format.ts";

export const prerender = false;

const { slug } = Astro.params;
const model = slug ? await getModel(env.STOCK_CACHE, slug) : null;
if (!model) Astro.response.status = 404;

const totals = model ? computeTotals(model) : null;
const writeToken = env.SOTP_WRITE_TOKEN ?? "";
const url = new URL(Astro.request.url);
const saved = url.searchParams.get("saved") === "1";
const importFailed = url.searchParams.get("import") === "failed";
const prefilled = url.searchParams.get("prefilled");
const segmentsFlag = url.searchParams.get("segments");
---

<html lang="en">
<head>
	<meta charset="utf-8" />
	<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	<meta name="viewport" content="width=device-width" />
	<title>{model ? `${model.companyName} — Valuation Lab` : "Not found — Valuation Lab"}</title>
	<script is:inline type="module" src="https://cdn.jsdelivr.net/npm/iconify-icon@1/dist/iconify-icon.min.js"></script>
</head>
<body class="min-h-screen bg-[color:var(--ink-900)] text-[color:var(--paper)]">
	<main class="w-full max-w-[96%] xl:max-w-[90%] mx-auto pb-12 pt-4 md:pt-8 md:px-8">
		<div class="mb-6 flex flex-col md:flex-row md:items-center justify-between gap-4">
			<div>
				<h1 class="text-3xl font-bold text-[color:var(--paper)] flex items-center gap-3">
					<iconify-icon icon="mdi:calculator-variant" class="text-[color:var(--accent)] text-4xl"></iconify-icon>
					{model ? model.companyName : "Model not found"}
					{model && <span class="text-sm font-mono font-normal text-[color:var(--paper-dim)]">{model.slug}</span>}
				</h1>
				<p class="text-[color:var(--paper-dim)] ml-11 text-sm">Sum-of-the-parts valuation — your estimates, your math.</p>
			</div>
			<a href="/projects/valuation-lab" class="flex gap-2 items-center px-4 py-2 border border-[color:var(--ink-600)] bg-[color:var(--ink-850)] hover:bg-[color:var(--ink-800)] hover:border-[color:var(--accent)] rounded-lg text-sm transition font-semibold shadow-sm">
				<iconify-icon icon="mdi:arrow-left" class="text-lg text-[color:var(--accent)]"></iconify-icon>
				All models
			</a>
		</div>

		{!model ? (
			<div class="mb-8 p-6 bg-[color:var(--ink-850)] border border-[color:var(--ink-600)] rounded-xl">
				<p class="text-[color:var(--paper-dim)]">No model at this address — it may have been deleted.</p>
				<a href="/projects/valuation-lab" class="text-[color:var(--accent)] underline">Back to the Valuation Lab</a>
			</div>
		) : (
			<>
				{saved && (
					<div class="mb-6 p-4 bg-[color:var(--ink-850)] border border-green-400/40 rounded-lg text-green-400">
						Saved.
					</div>
				)}
				{importFailed && (
					<div class="mb-6 p-4 bg-[color:var(--ink-850)] border border-[color:var(--accent)]/30 rounded-lg text-[color:var(--accent)]">
						Couldn't seed parts from that ticker (no SEC segments, or the LLM step failed) — add parts manually below.
					</div>
				)}
				{prefilled === "1" && (
					<div class="mb-6 p-4 bg-[color:var(--ink-850)] border border-green-400/40 rounded-lg text-green-400 text-sm">
						Prefilled empty bridge fields from the latest 10-Q — values are raw filing units (USD), sanity-check them.
					</div>
				)}
				{prefilled === "0" && (
					<div class="mb-6 p-4 bg-[color:var(--ink-850)] border border-[color:var(--ink-600)] rounded-lg text-[color:var(--paper-dim)] text-sm">
						Nothing new to prefill — no usable balance-sheet data from the latest filing, or those fields were already set.
					</div>
				)}
				{segmentsFlag === "1" && (
					<div class="mb-6 p-4 bg-[color:var(--ink-850)] border border-green-400/40 rounded-lg text-green-400 text-sm">
						Segment rows filled/appended — revenue refs are prefilled where labels matched; set each × multiple.
					</div>
				)}
				{segmentsFlag === "0" && (
					<div class="mb-6 p-4 bg-[color:var(--ink-850)] border border-[color:var(--ink-600)] rounded-lg text-[color:var(--paper-dim)] text-sm">
						No segment data found for that ticker (missing filing, or the LLM step has not cached this ticker yet) — nothing changed.
					</div>
				)}
				{model.importedFrom && (
					<p class="mb-6 text-xs text-[color:var(--paper-muted)] italic">
						Parts seeded from {model.importedFrom.ticker} segment revenue (period {model.importedFrom.period}) — valuations are yours to fill in.
					</p>
				)}

				<form id="sotp-form" method="POST" action="/projects/valuation-lab/actions" data-currency={cur(model.currency)} data-has-bridge={totals?.equity ? "1" : "0"}
					class="bg-[color:var(--ink-850)] border border-[color:var(--ink-600)] rounded-xl p-6 shadow-sm">
					<input type="hidden" name="action" value="save" />
					<input type="hidden" name="slug" value={model.slug} />
					{writeToken && <input type="hidden" name="writeToken" value={writeToken} />}
					{model.importedFrom && (
						<>
							<input type="hidden" name="importTicker" value={model.importedFrom.ticker} />
							<input type="hidden" name="importPeriod" value={model.importedFrom.period} />
						</>
					)}

					<div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
						<label class="block">
							<span class="block text-xs font-semibold uppercase tracking-wider text-[color:var(--paper-dim)] mb-1">Company name</span>
							<input type="text" name="companyName" value={model.companyName} maxlength="120" required
								class="w-full bg-[color:var(--ink-900)] border border-[color:var(--ink-700)] rounded-md px-3 py-2 text-[color:var(--paper)] focus:outline-none focus:border-[color:var(--accent)]" />
						</label>
						<label class="block">
							<span class="block text-xs font-semibold uppercase tracking-wider text-[color:var(--paper-dim)] mb-1">Currency</span>
							<input type="text" name="currency" value={model.currency} maxlength="8"
								class="w-full bg-[color:var(--ink-900)] border border-[color:var(--ink-700)] rounded-md px-3 py-2 text-[color:var(--paper)] focus:outline-none focus:border-[color:var(--accent)]" />
						</label>
						<label class="block">
							<span class="block text-xs font-semibold uppercase tracking-wider text-[color:var(--paper-dim)] mb-1">Shares outstanding</span>
							<input type="text" inputmode="decimal" name="sharesOutstanding" value={model.sharesOutstanding ?? ""} placeholder="e.g. 2,100,000,000"
								class="w-full bg-[color:var(--ink-900)] border border-[color:var(--ink-700)] rounded-md px-3 py-2 font-mono text-[color:var(--paper)] focus:outline-none focus:border-[color:var(--accent)]" />
						</label>
					</div>

					<div class="mb-3 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
						<h2 class="text-lg font-bold text-[color:var(--paper)]">Parts</h2>
						<div class="flex items-center gap-2">
							<input type="text" form="append-segments-form" name="segTicker" value={model.importedFrom?.ticker ?? ""} maxlength="20" placeholder="AAPL"
								class="w-28 bg-[color:var(--ink-900)] border border-[color:var(--ink-700)] rounded-md px-3 py-2 font-mono uppercase text-sm text-[color:var(--paper)] focus:outline-none focus:border-[color:var(--accent)]" />
							<button type="submit" form="append-segments-form"
								class="inline-flex items-center gap-2 px-4 py-2 border border-[color:var(--ink-600)] bg-[color:var(--ink-800)] hover:border-[color:var(--accent)] rounded-lg text-sm font-semibold transition cursor-pointer">
								<iconify-icon icon="mdi:table-import" class="text-lg text-[color:var(--accent)]"></iconify-icon>
								Fill segment rows
							</button>
						</div>
					</div>
					<div class="overflow-x-auto">
						<table class="w-full text-sm">
							<thead>
								<tr class="text-left text-xs font-semibold text-[color:var(--paper-dim)] uppercase tracking-wider border-b border-[color:var(--ink-600)]">
									<th class="py-2 pr-4 w-1/5">Part</th>
									<th class="py-2 pr-4">Mode</th>
									<th class="py-2 pr-4 w-1/5">Valuation</th>
									<th class="py-2 pr-4">× Revenue</th>
									<th class="py-2 pr-4">Reasoning / note</th>
									<th class="py-2 w-10"></th>
								</tr>
							</thead>
							<tbody id="part-rows" class="divide-y divide-[color:var(--ink-700)]">
								{model.parts.map((p) => {
									const isMult = p.mode === "multiple";
									const preview = isMult && p.revenueRef != null && (p.multiple ?? 0) > 0
										? `= ${cur(model.currency)}${formatNumber(p.revenueRef * (p.multiple ?? 0))}`
										: "";
									return (
									<tr>
										<td class="py-2 pr-4">
											<input type="text" name="partLabel" value={p.label} maxlength="120" placeholder="e.g. Starlink"
												class="w-full bg-transparent border border-transparent hover:border-[color:var(--ink-700)] focus:bg-[color:var(--ink-900)] focus:border-[color:var(--accent)] rounded-md px-2 py-1.5 text-[color:var(--paper)] focus:outline-none" />
										</td>
										<td class="py-2 pr-4">
											<select name="partMode"
												class="w-full bg-transparent border border-transparent hover:border-[color:var(--ink-700)] focus:bg-[color:var(--ink-900)] focus:border-[color:var(--accent)] rounded-md px-2 py-1.5 text-[color:var(--paper-dim)] focus:outline-none cursor-pointer">
												<option value="manual" selected={!isMult}>Manual value</option>
												<option value="multiple" selected={isMult}>× revenue</option>
											</select>
										</td>
										<td class="py-2 pr-4">
											<input type="text" inputmode="decimal" name="partValuation" value={p.valuation} placeholder="0"
												class="w-full bg-transparent border border-transparent hover:border-[color:var(--ink-700)] focus:bg-[color:var(--ink-900)] focus:border-[color:var(--accent)] rounded-md px-2 py-1.5 font-mono text-[color:var(--accent)] focus:outline-none" />
										</td>
										<td class="py-2 pr-4">
											<div data-multiple-cell class={isMult ? "space-y-0.5" : "hidden"}>
												<div class="flex items-center gap-1">
													<input type="text" inputmode="decimal" name="partRevenueRef" value={p.revenueRef ?? ""} placeholder="revenue"
														class="w-28 bg-[color:var(--ink-900)] border border-[color:var(--ink-700)] rounded-md px-2 py-1 font-mono text-xs text-[color:var(--paper)] focus:outline-none focus:border-[color:var(--accent)]" />
													<span class="text-xs text-[color:var(--paper-dim)]">×</span>
													<input type="text" inputmode="decimal" name="partMultiple" value={p.multiple ?? ""} placeholder="8"
														class="w-16 bg-[color:var(--ink-900)] border border-[color:var(--ink-700)] rounded-md px-2 py-1 font-mono text-xs text-[color:var(--accent)] focus:outline-none focus:border-[color:var(--accent)]" />
												</div>
												<p data-multiple-preview class="text-xs font-mono text-[color:var(--paper-muted)]">{preview}</p>
											</div>
										</td>
										<td class="py-2 pr-4">
											<input type="text" name="partNote" value={p.note} maxlength="500" placeholder="e.g. 8× 2026E revenue of $12B"
												class="w-full bg-transparent border border-transparent hover:border-[color:var(--ink-700)] focus:bg-[color:var(--ink-900)] focus:border-[color:var(--accent)] rounded-md px-2 py-1.5 text-[color:var(--paper-dim)] focus:outline-none" />
										</td>
										<td class="py-2 text-center">
											<button type="button" data-remove aria-label="Remove part"
												class="text-[color:var(--paper-dim)] hover:text-[color:var(--accent)] rounded p-1 cursor-pointer">
												<iconify-icon icon="mdi:close"></iconify-icon>
											</button>
										</td>
									</tr>
									);
								})}
							</tbody>
						</table>
					</div>

					<template id="part-row">
						<tr>
							<td class="py-2 pr-4">
								<input type="text" name="partLabel" maxlength="120" placeholder="e.g. Starlink"
									class="w-full bg-transparent border border-transparent hover:border-[color:var(--ink-700)] focus:bg-[color:var(--ink-900)] focus:border-[color:var(--accent)] rounded-md px-2 py-1.5 text-[color:var(--paper)] focus:outline-none" />
							</td>
							<td class="py-2 pr-4">
								<select name="partMode"
									class="w-full bg-transparent border border-transparent hover:border-[color:var(--ink-700)] focus:bg-[color:var(--ink-900)] focus:border-[color:var(--accent)] rounded-md px-2 py-1.5 text-[color:var(--paper-dim)] focus:outline-none cursor-pointer">
									<option value="manual" selected>Manual value</option>
									<option value="multiple">× revenue</option>
								</select>
							</td>
							<td class="py-2 pr-4">
								<input type="text" inputmode="decimal" name="partValuation" placeholder="0"
									class="w-full bg-transparent border border-transparent hover:border-[color:var(--ink-700)] focus:bg-[color:var(--ink-900)] focus:border-[color:var(--accent)] rounded-md px-2 py-1.5 font-mono text-[color:var(--accent)] focus:outline-none" />
							</td>
							<td class="py-2 pr-4">
								<div data-multiple-cell class="hidden">
									<div class="flex items-center gap-1">
										<input type="text" inputmode="decimal" name="partRevenueRef" placeholder="revenue"
											class="w-28 bg-[color:var(--ink-900)] border border-[color:var(--ink-700)] rounded-md px-2 py-1 font-mono text-xs text-[color:var(--paper)] focus:outline-none focus:border-[color:var(--accent)]" />
										<span class="text-xs text-[color:var(--paper-dim)]">×</span>
										<input type="text" inputmode="decimal" name="partMultiple" placeholder="8"
											class="w-16 bg-[color:var(--ink-900)] border border-[color:var(--ink-700)] rounded-md px-2 py-1 font-mono text-xs text-[color:var(--accent)] focus:outline-none focus:border-[color:var(--accent)]" />
									</div>
									<p data-multiple-preview class="text-xs font-mono text-[color:var(--paper-muted)]"></p>
								</div>
							</td>
							<td class="py-2 pr-4">
								<input type="text" name="partNote" maxlength="500" placeholder="reasoning"
									class="w-full bg-transparent border border-transparent hover:border-[color:var(--ink-700)] focus:bg-[color:var(--ink-900)] focus:border-[color:var(--accent)] rounded-md px-2 py-1.5 text-[color:var(--paper-dim)] focus:outline-none" />
							</td>
							<td class="py-2 text-center">
								<button type="button" data-remove aria-label="Remove part"
									class="text-[color:var(--paper-dim)] hover:text-[color:var(--accent)] rounded p-1 cursor-pointer">
									<iconify-icon icon="mdi:close"></iconify-icon>
								</button>
							</td>
						</tr>
					</template>

					<button type="button" id="add-part"
						class="mt-4 inline-flex items-center gap-1.5 text-sm text-[color:var(--accent)] hover:text-[color:var(--paper)] font-semibold cursor-pointer">
						<iconify-icon icon="mdi:plus-circle-outline" class="text-lg"></iconify-icon>
						Add part
					</button>

					<!-- Totals (live-updated by the script below; server-rendered initial values) -->
					<div class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-4 border-t border-[color:var(--ink-700)] pt-5">
						<div>
							<p class="text-xs font-semibold uppercase tracking-wider text-[color:var(--paper-dim)] mb-1">Total value</p>
							<p id="sotp-total" class="text-3xl font-bold text-[color:var(--paper)]">
								{cur(model.currency)}{formatNumber(totals?.total ?? 0)}
							</p>
							<p class="text-xs text-[color:var(--paper-muted)] mt-1">{model.parts.length} parts, summed</p>
						</div>
						<div>
							<p class="text-xs font-semibold uppercase tracking-wider text-[color:var(--paper-dim)] mb-1">Per share</p>
							<p id="sotp-per-share" class="text-3xl font-bold text-[color:var(--accent)]">
								{totals?.perShare !== null && totals ? `${cur(model.currency)}${formatPrice(totals.perShare)}` : "—"}
							</p>
							<p class="text-xs text-[color:var(--paper-muted)] mt-1">total ÷ shares outstanding</p>
						</div>
					</div>

					<!-- Equity bridge (optional). Inputs are plain text; blank = no bridge. -->
					<div class="mt-6 border-t border-[color:var(--ink-700)] pt-6">
						<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4">
							<div>
								<h2 class="text-lg font-bold text-[color:var(--paper)]">Equity bridge</h2>
								<p class="text-xs text-[color:var(--paper-muted)] mt-0.5">From parts value to equity value per share — all optional; leave blank to skip.</p>
							</div>
							{model.importedFrom && (
								<button type="submit" form="prefill-bridge-form"
									class="inline-flex items-center gap-2 px-4 py-2 border border-[color:var(--ink-600)] bg-[color:var(--ink-800)] hover:border-[color:var(--accent)] rounded-lg text-sm font-semibold transition cursor-pointer">
									<iconify-icon icon="mdi:database-import-outline" class="text-lg text-[color:var(--accent)]"></iconify-icon>
									Prefill bridge from filing
								</button>
							)}
						</div>

						<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
							<label class="block">
								<span class="block text-xs font-semibold uppercase tracking-wider text-[color:var(--paper-dim)] mb-1">Net debt</span>
								<input type="text" inputmode="decimal" name="netDebt" value={model.bridge?.netDebt ?? ""} placeholder="e.g. -60,600,000,000"
									class="w-full bg-[color:var(--ink-900)] border border-[color:var(--ink-700)] rounded-md px-3 py-2 font-mono text-[color:var(--paper)] focus:outline-none focus:border-[color:var(--accent)]" />
								<span class="block text-xs text-[color:var(--paper-muted)] mt-1">Positive = debt to subtract; negative = net cash adds back.</span>
							</label>
							<label class="block">
								<span class="block text-xs font-semibold uppercase tracking-wider text-[color:var(--paper-dim)] mb-1">Minority interests</span>
								<input type="text" inputmode="decimal" name="minorityInterests" value={model.bridge?.minorityInterests ?? ""} placeholder="0"
									class="w-full bg-[color:var(--ink-900)] border border-[color:var(--ink-700)] rounded-md px-3 py-2 font-mono text-[color:var(--paper)] focus:outline-none focus:border-[color:var(--accent)]" />
								<span class="block text-xs text-[color:var(--paper-muted)] mt-1">Non-controlling stakes, subtracted from equity value.</span>
							</label>
							<label class="block">
								<span class="block text-xs font-semibold uppercase tracking-wider text-[color:var(--paper-dim)] mb-1">Preferred stock</span>
								<input type="text" inputmode="decimal" name="preferred" value={model.bridge?.preferred ?? ""} placeholder="0"
									class="w-full bg-[color:var(--ink-900)] border border-[color:var(--ink-700)] rounded-md px-3 py-2 font-mono text-[color:var(--paper)] focus:outline-none focus:border-[color:var(--accent)]" />
								<span class="block text-xs text-[color:var(--paper-muted)] mt-1">Redeemable / preferred claims, subtracted.</span>
							</label>
							<label class="block">
								<span class="block text-xs font-semibold uppercase tracking-wider text-[color:var(--paper-dim)] mb-1">SOTP discount %</span>
								<input type="text" inputmode="decimal" name="sotpDiscountPct" value={model.bridge?.sotpDiscountPct ?? ""} placeholder="e.g. 10"
									class="w-full bg-[color:var(--ink-900)] border border-[color:var(--ink-700)] rounded-md px-3 py-2 font-mono text-[color:var(--paper)] focus:outline-none focus:border-[color:var(--accent)]" />
								<span class="block text-xs text-[color:var(--paper-muted)] mt-1">0–30, e.g. 10 for a typical conglomerate discount.</span>
							</label>
							<label class="block">
								<span class="block text-xs font-semibold uppercase tracking-wider text-[color:var(--paper-dim)] mb-1">Illiquidity %</span>
								<input type="text" inputmode="decimal" name="illiquidityPct" value={model.bridge?.illiquidityPct ?? ""} placeholder="e.g. 15"
									class="w-full bg-[color:var(--ink-900)] border border-[color:var(--ink-700)] rounded-md px-3 py-2 font-mono text-[color:var(--paper)] focus:outline-none focus:border-[color:var(--accent)]" />
								<span class="block text-xs text-[color:var(--paper-muted)] mt-1">0–60; meaningful for private companies.</span>
							</label>
						</div>

						<div class="mt-5 grid grid-cols-1 sm:grid-cols-2 gap-4 bg-[color:var(--ink-900)]/60 border border-[color:var(--ink-700)] rounded-lg p-4">
							<div class="space-y-2 text-sm">
								<div class="flex items-center justify-between gap-4">
									<span class="text-[color:var(--paper-dim)]">After net debt</span>
									<span id="sotp-bridge-after-net-debt" class="font-mono text-[color:var(--paper)]">{totals?.equity ? `${cur(model.currency)}${formatNumber(totals.equity.afterNetDebt)}` : "—"}</span>
								</div>
								<div class="flex items-center justify-between gap-4">
									<span class="text-[color:var(--paper-dim)]">After minorities &amp; preferred</span>
									<span id="sotp-bridge-after-interests" class="font-mono text-[color:var(--paper)]">{totals?.equity ? `${cur(model.currency)}${formatNumber(totals.equity.afterInterests)}` : "—"}</span>
								</div>
								<div class="flex items-center justify-between gap-4">
									<span class="text-[color:var(--paper-dim)]">After SOTP &amp; illiquidity discounts</span>
									<span id="sotp-bridge-after-discount" class="font-mono text-[color:var(--paper)]">{totals?.equity ? `${cur(model.currency)}${formatNumber(totals.equity.afterDiscount)}` : "—"}</span>
								</div>
							</div>
							<div>
								<p class="text-xs font-semibold uppercase tracking-wider text-[color:var(--paper-dim)] mb-1">Equity value</p>
								<p id="sotp-bridge-equity" class="text-3xl font-bold text-[color:var(--paper)]">{totals?.equity ? `${cur(model.currency)}${formatNumber(totals.equity.equityValue)}` : "—"}</p>
								<p class="text-xs font-semibold uppercase tracking-wider text-[color:var(--paper-dim)] mt-3 mb-1">Per share (bridge)</p>
								<p id="sotp-bridge-per-share" class="text-2xl font-bold text-[color:var(--accent)]">{totals?.equity?.perShare != null ? `${cur(model.currency)}${formatPrice(totals.equity.perShare)}` : "—"}</p>
							</div>
						</div>
					</div>

					<button type="submit"
						class="mt-6 inline-flex items-center gap-2 px-5 py-2.5 bg-[color:var(--accent)] hover:opacity-90 rounded-lg font-semibold text-sm transition">
						<iconify-icon icon="mdi:content-save"></iconify-icon>
						Save model
					</button>
				</form>

				{model.importedFrom && (
					<form id="prefill-bridge-form" method="POST" action="/projects/valuation-lab/actions" class="hidden">
						<input type="hidden" name="action" value="prefill-bridge" />
						<input type="hidden" name="slug" value={model.slug} />
						<input type="hidden" name="bridgeTicker" value={model.importedFrom.ticker} />
						{writeToken && <input type="hidden" name="writeToken" value={writeToken} />}
					</form>
				)}

				<form id="append-segments-form" method="POST" action="/projects/valuation-lab/actions" class="hidden">
					<input type="hidden" name="action" value="append-segments" />
					<input type="hidden" name="slug" value={model.slug} />
					{writeToken && <input type="hidden" name="writeToken" value={writeToken} />}
				</form>

				<form method="POST" action="/projects/valuation-lab/actions" class="mt-4"
					onsubmit="return confirm('Delete this model? This cannot be undone.')">
					<input type="hidden" name="action" value="delete" />
					<input type="hidden" name="slug" value={model.slug} />
					{writeToken && <input type="hidden" name="writeToken" value={writeToken} />}
					<button type="submit" class="text-xs text-[color:var(--paper-dim)] hover:text-[color:var(--accent)] underline cursor-pointer">
						Delete this model
					</button>
				</form>
			</>
		)}
	</main>

	<script>
		// Live editor — the server recomputes everything on save; this is
		// progressive enhancement only. It updates part totals (including
		// × revenue rows), toggles the multiple inputs, and renders the
		// equity-bridge waterfall.
		const form = document.getElementById("sotp-form") as HTMLFormElement | null;
		const currency = form?.dataset.currency ?? "";
		const fmt = (n: number): string =>
			n.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
		const fmtCompact = (n: number): string => {
			const abs = Math.abs(n);
			if (abs >= 1e12) return `${(n / 1e12).toFixed(2)}T`;
			if (abs >= 1e9) return `${(n / 1e9).toFixed(2)}B`;
			if (abs >= 1e6) return `${(n / 1e6).toFixed(2)}M`;
			if (abs >= 1e3) return `${(n / 1e3).toFixed(2)}K`;
			return n.toFixed(2);
		};
		const numOf = (el: HTMLInputElement | HTMLSelectElement | null): number => {
			if (!el) return 0;
			const n = Number(el.value.replace(/[\s,$]/g, ""));
			return Number.isFinite(n) ? n : 0;
		};
		const setText = (id: string, text: string): void => {
			const el = document.getElementById(id);
			if (el) el.textContent = text;
		};
		const clampPct = (v: number, lo: number, hi: number): number => (v >= lo && v <= hi ? v : 0);

		const recompute = (): void => {
			if (!form) return;

			// A × revenue row's effective value is revenueRef × multiple, mirroring
			// the server's recomputeMultiples; manual rows use their own input.
			let total = 0;
			form.querySelectorAll<HTMLTableRowElement>("#part-rows tr").forEach((row) => {
				const modeEl = row.querySelector<HTMLSelectElement>('select[name="partMode"]');
				const cell = row.querySelector<HTMLElement>("[data-multiple-cell]");
				const preview = row.querySelector<HTMLElement>("[data-multiple-preview]");
				const valInput = row.querySelector<HTMLInputElement>('input[name="partValuation"]');
				const isMultiple = modeEl?.value === "multiple";
				cell?.classList.toggle("hidden", !isMultiple);
				if (isMultiple) {
					const ref = numOf(row.querySelector<HTMLInputElement>('input[name="partRevenueRef"]'));
					const multiple = numOf(row.querySelector<HTMLInputElement>('input[name="partMultiple"]'));
					if (ref !== 0 && multiple > 0) {
						const value = ref * multiple;
						if (valInput) valInput.value = String(value);
						if (preview) preview.textContent = `= ${currency}${fmtCompact(value)}`;
					} else if (preview) {
						preview.textContent = "";
					}
				} else if (preview) {
					preview.textContent = "";
				}
				total += numOf(valInput);
			});

			setText("sotp-total", `${currency}${fmt(total)}`);

			const sharesInput = form.querySelector<HTMLInputElement>('input[name="sharesOutstanding"]');
			const shares = sharesInput ? Number(sharesInput.value.replace(/[\s,$]/g, "")) : NaN;
			const sharesValid = Number.isFinite(shares) && shares > 0;
			setText("sotp-per-share", sharesValid ? `${currency}${fmt(total / shares)}` : "—");

			// Equity bridge waterfall. A model with no bridge shows "—" until the
			// user enters a bridge field (legacy models stay visually unchanged).
			const bridgeField = (name: string): HTMLInputElement | null =>
				form.querySelector<HTMLInputElement>(`input[name="${name}"]`);
			const bridgeNames = ["netDebt", "minorityInterests", "preferred", "sotpDiscountPct", "illiquidityPct"];
			const hasBridgeInput = bridgeNames.some((n) => (bridgeField(n)?.value ?? "").trim() !== "");
			if (form.dataset.hasBridge !== "1" && !hasBridgeInput) {
				["sotp-bridge-after-net-debt", "sotp-bridge-after-interests", "sotp-bridge-after-discount"].forEach((id) => setText(id, "—"));
				setText("sotp-bridge-equity", "—");
				setText("sotp-bridge-per-share", "—");
				return;
			}
			const afterNetDebt = total - numOf(bridgeField("netDebt"));
			const afterInterests = afterNetDebt - numOf(bridgeField("minorityInterests")) - numOf(bridgeField("preferred"));
			const afterDiscount =
				afterInterests *
				(1 - clampPct(numOf(bridgeField("sotpDiscountPct")), 0, 30) / 100) *
				(1 - clampPct(numOf(bridgeField("illiquidityPct")), 0, 60) / 100);
			setText("sotp-bridge-after-net-debt", `${currency}${fmtCompact(afterNetDebt)}`);
			setText("sotp-bridge-after-interests", `${currency}${fmtCompact(afterInterests)}`);
			setText("sotp-bridge-after-discount", `${currency}${fmtCompact(afterDiscount)}`);
			setText("sotp-bridge-equity", `${currency}${fmtCompact(afterDiscount)}`);
			setText("sotp-bridge-per-share", sharesValid ? `${currency}${fmt(afterDiscount / shares)}` : "—");
		};
		form?.addEventListener("input", recompute);
		form?.addEventListener("change", recompute);

		// Add part — clone the <template> row (kept in sync with rendered rows
		// by hand; every row must always submit every field so the server's
		// index-zip parsing stays aligned).
		const rows = document.getElementById("part-rows");
		const tpl = document.getElementById("part-row") as HTMLTemplateElement | null;
		document.getElementById("add-part")?.addEventListener("click", () => {
			if (!rows || !tpl) return;
			if (rows.querySelectorAll("tr").length >= 50) return; // MAX_PARTS
			rows.appendChild(tpl.content.cloneNode(true));
			recompute();
		});

		// Remove part (event delegation — also covers template-cloned rows).
		rows?.addEventListener("click", (e) => {
			const btn = (e.target as HTMLElement).closest("button[data-remove]");
			if (btn) btn.closest("tr")?.remove();
			recompute();
		});

		recompute();
	</script>
</body>
</html>
