    <script>
/* =========================================================
   VALUATION DESK — core logic
   ========================================================= */

const FMP_BASE = 'https://financialmodelingprep.com/stable/';

const METRIC_DEFS = [
  { key: 'revenue',   label: 'Revenue',        color: 'var(--brass)' },
  { key: 'ebitda',    label: 'EBITDA',         color: 'var(--teal)'  },
  { key: 'netIncome', label: 'Net Income',     color: 'var(--blue)'  },
  { key: 'fcf',       label: 'Free Cash Flow', color: 'var(--negative)' }
];

const MODEL_LABELS = {
  linear: 'Linear',
  exponential: 'Exponential',
  avg: 'Avg YoY %',
  custom: 'Custom'
};

function defaultYears() {
  const now = new Date();
  const lastFullYear = now.getFullYear() - 1;
  const out = [];
  for (let y = lastFullYear - 4; y <= lastFullYear; y++) out.push(y);
  return out;
}

function makeMetricState() {
  const years = defaultYears();
  return years.map(() => 0);
}

const state = {
  ticker: '',
  years: defaultYears(),
  projYears: 5,
  unitLabel: 'Millions',
  unitScale: 1e6,
  showGrowthRows: false,
  company: {
    name: '', sector: '', exchange: '', currency: 'USD',
    price: 0, marketCap: 0, shares: 0, netDebt: 0
  },
  metrics: {
    revenue:   { hist: makeMetricState(), model: 'linear', overrides: {}, customRates: [] },
    ebitda:    { hist: makeMetricState(), model: 'linear', overrides: {}, customRates: [] },
    netIncome: { hist: makeMetricState(), model: 'linear', overrides: {}, customRates: [] },
    fcf:       { hist: makeMetricState(), model: 'linear', overrides: {}, customRates: [] }
  },
  dcf: { wacc: 9, tgr: 2.5 },
  comps: { peerPE: 0, peerEvEbitda: 0 },
  status: { message: '', tone: 'idle' }
};

let chartInstance = null;

/* ---------------- helpers ---------------- */

function pick(obj, keys, fallback) {
  for (const k of keys) {
    if (obj && obj[k] !== undefined && obj[k] !== null && !Number.isNaN(obj[k])) return obj[k];
  }
  return fallback === undefined ? null : fallback;
}

function fmt(n, decimals) {
  if (n === null || n === undefined || Number.isNaN(n)) return '\u2014';
  const d = decimals === undefined ? 1 : decimals;
  return Number(n).toLocaleString('en-US', { minimumFractionDigits: d, maximumFractionDigits: d });
}

function fmtPct(n, decimals) {
  if (n === null || n === undefined || Number.isNaN(n)) return '\u2014';
  const d = decimals === undefined ? 1 : decimals;
  const sign = n > 0 ? '+' : '';
  return sign + Number(n).toFixed(d) + '%';
}

function clampNum(v, fallback) {
  const n = parseFloat(v);
  return Number.isFinite(n) ? n : (fallback === undefined ? 0 : fallback);
}

/* ---------------- regression / projection ---------------- */

function linReg(xs, ys) {
  const n = xs.length;
  let sx = 0, sy = 0, sxy = 0, sxx = 0;
  for (let i = 0; i < n; i++) {
    sx += xs[i]; sy += ys[i]; sxy += xs[i] * ys[i]; sxx += xs[i] * xs[i];
  }
  const denom = n * sxx - sx * sx;
  if (denom === 0) return { a: n ? sy / n : 0, b: 0 };
  const b = (n * sxy - sx * sy) / denom;
  const a = (sy - b * sx) / n;
  return { a, b };
}

function projectSeries(hist, model, n, customRates) {
  const len = hist.length;
  const out = [];
  if (len === 0 || n <= 0) return out;

  if (model === 'exponential') {
    const allPositive = hist.every(v => v > 0);
    if (!allPositive || len < 2) {
      return projectSeries(hist, 'linear', n, customRates);
    }
    const xs = hist.map((_, i) => i);
    const ys = hist.map(v => Math.log(v));
    const { a, b } = linReg(xs, ys);
    for (let k = 0; k < n; k++) out.push(Math.exp(a + b * (len + k)));
    return out;
  }

  if (model === 'avg') {
    const growths = [];
    for (let i = 1; i < len; i++) {
      if (hist[i - 1] !== 0) growths.push(hist[i] / hist[i - 1] - 1);
    }
    const g = growths.length ? growths.reduce((s, v) => s + v, 0) / growths.length : 0;
    let v = hist[len - 1];
    for (let k = 0; k < n; k++) { v = v * (1 + g); out.push(v); }
    return out;
  }

  if (model === 'custom') {
    let v = hist[len - 1];
    for (let k = 0; k < n; k++) {
      const rate = (customRates && customRates[k] !== undefined) ? customRates[k] : 0;
      v = v * (1 + rate / 100);
      out.push(v);
    }
    return out;
  }

  // linear (default / fallback)
  const xs = hist.map((_, i) => i);
  const { a, b } = linReg(xs, hist);
  for (let k = 0; k < n; k++) out.push(a + b * (len + k));
  return out;
}

function avgGrowthRate(hist) {
  const growths = [];
  for (let i = 1; i < hist.length; i++) {
    if (hist[i - 1] !== 0) growths.push(hist[i] / hist[i - 1] - 1);
  }
  if (!growths.length) return 0;
  return growths.reduce((s, v) => s + v, 0) / growths.length;
}

function getProjected(metricKey) {
  const m = state.metrics[metricKey];
  if (m.model === 'custom' && (!m.customRates || m.customRates.length < state.projYears)) {
    const seedRate = Math.round(avgGrowthRate(m.hist) * 1000) / 10; // %
    const rates = m.customRates ? m.customRates.slice() : [];
    while (rates.length < state.projYears) rates.push(seedRate);
    m.customRates = rates;
  }
  const raw = projectSeries(m.hist, m.model, state.projYears, m.customRates);
  const out = raw.slice();
  Object.keys(m.overrides).forEach(k => {
    const idx = parseInt(k, 10);
    if (idx >= 0 && idx < out.length) out[idx] = m.overrides[idx];
  });
  return out;
}

/* ---------------- DCF math ---------------- */

function calcIntrinsicValue(fcfArr, waccPct, tgrPct, netDebt, shares) {
  const wacc = waccPct / 100;
  const tgr = tgrPct / 100;
  if (wacc <= tgr) return null;
  let sumPV = 0;
  for (let k = 0; k < fcfArr.length; k++) {
    const df = 1 / Math.pow(1 + wacc, k + 1);
    sumPV += fcfArr[k] * df;
  }
  const lastFcf = fcfArr[fcfArr.length - 1];
  const tv = (lastFcf * (1 + tgr)) / (wacc - tgr);
  const pvTv = tv / Math.pow(1 + wacc, fcfArr.length);
  const ev = sumPV + pvTv;
  const equity = ev - netDebt;
  if (!shares) return null;
  return equity / shares;
}

/* ---------------- unit rescaling ---------------- */

function rescaleUnits(newScale) {
  const ratio = state.unitScale / newScale;
  METRIC_DEFS.forEach(({ key }) => {
    const m = state.metrics[key];
    m.hist = m.hist.map(v => v * ratio);
    Object.keys(m.overrides).forEach(k => { m.overrides[k] = m.overrides[k] * ratio; });
  });
  state.company.netDebt = state.company.netDebt * ratio;
  state.unitScale = newScale;
}

/* ---------------- year helpers ---------------- */

function getRowYear(row) {
  if (row.calendarYear) return parseInt(row.calendarYear, 10);
  if (row.date) return parseInt(String(row.date).slice(0, 4), 10);
  if (row.fiscalYear) return parseInt(row.fiscalYear, 10);
  return null;
}

function calcFCFRow(row) {
  const direct = pick(row, ['freeCashFlow']);
  if (direct !== null) return direct;
  const ocf = pick(row, ['operatingCashFlow', 'netCashProvidedByOperatingActivities'], 0);
  const capex = pick(row, ['capitalExpenditure'], 0);
  return ocf + capex;
}
/* =========================================================
   VALUATION DESK — rendering, events, data fetch
   (depends on core.js being loaded first)
   ========================================================= */

const COLORS = {
  brass: '#C9A227', teal: '#4F9C93', blue: '#6E9BC9',
  negative: '#D97B7B', positive: '#6FB98F',
  ink: '#EDE7D9', inkDim: '#8C96AB', hairline: '#2A3446'
};
METRIC_DEFS[0].color = COLORS.brass;
METRIC_DEFS[1].color = COLORS.teal;
METRIC_DEFS[2].color = COLORS.blue;
METRIC_DEFS[3].color = COLORS.negative;

function $(id) { return document.getElementById(id); }

function roundSmart(v) {
  if (v === null || v === undefined || Number.isNaN(v)) return 0;
  const abs = Math.abs(v);
  if (abs >= 100) return Math.round(v);
  if (abs >= 1) return Math.round(v * 10) / 10;
  return Math.round(v * 1000) / 1000;
}

function unitSuffix() {
  if (state.unitScale === 1e3) return 'K';
  if (state.unitScale === 1e9) return 'B';
  return 'M';
}

function autoFmtCurrency(n) {
  if (!n) return '\u2014';
  const abs = Math.abs(n);
  if (abs >= 1e12) return (n / 1e12).toFixed(2) + 'T';
  if (abs >= 1e9) return (n / 1e9).toFixed(2) + 'B';
  if (abs >= 1e6) return (n / 1e6).toFixed(1) + 'M';
  if (abs >= 1e3) return (n / 1e3).toFixed(1) + 'K';
  return n.toFixed(2);
}

function setStatus(msg, tone) {
  state.status = { message: msg, tone: tone || 'idle' };
  const bar = $('statusBar');
  if (!msg) { bar.hidden = true; return; }
  bar.hidden = false;
  bar.textContent = msg;
  bar.className = 'status-bar tone-' + tone;
}

function projYearLabels() {
  const lastHist = state.years[state.years.length - 1] || (new Date().getFullYear() - 1);
  const out = [];
  for (let k = 0; k < state.projYears; k++) out.push(lastHist + 1 + k);
  return out;
}

/* ---------------- snapshot & ticker readout ---------------- */

function renderSnapshot() {
  const c = state.company;
  const el = $('snapshot');
  if (!c.name && !state.ticker) {
    el.innerHTML = '<p class="snapshot-empty">Enter a ticker and API key above, then fetch \u2014 or just start typing figures into the table below.</p>';
    return;
  }
  const parts = [];
  parts.push('<div class="snap-name">' + (c.name || state.ticker) + ' <span class="snap-ticker">' + state.ticker + '</span></div>');
  const meta = [c.sector, c.exchange, c.currency].filter(Boolean).join(' \u00b7 ');
  parts.push('<div class="snap-meta">' + meta + '</div>');
  parts.push('<div class="snap-stats">');
  parts.push('<div class="snap-stat"><span class="snap-label">Price</span><span class="snap-value">' + fmt(c.price, 2) + '</span></div>');
  parts.push('<div class="snap-stat"><span class="snap-label">Market cap</span><span class="snap-value">' + autoFmtCurrency(c.marketCap) + '</span></div>');
  parts.push('<div class="snap-stat"><span class="snap-label">Diluted shares</span><span class="snap-value">' + fmt(c.shares, 1) + 'M</span></div>');
  parts.push('</div>');
  el.innerHTML = parts.join('');
}

function renderTickerReadout(dcfDetail) {
  const el = $('tickerReadout');
  const price = state.company.price;
  const iv = dcfDetail && dcfDetail.valid ? dcfDetail.ivPerShare : null;
  const delta = (iv !== null && price) ? (iv / price - 1) * 100 : null;
  const deltaClass = delta === null ? '' : (delta >= 0 ? 'pos' : 'neg');
  const html =
    '<div class="stat-block">' +
      '<span class="stat-label">Intrinsic value / share</span>' +
      '<span class="stat-value">' + (iv !== null ? fmt(iv, 2) : '\u2014') + '</span>' +
    '</div>' +
    '<div class="stat-block">' +
      '<span class="stat-label">Current price</span>' +
      '<span class="stat-value">' + (price ? fmt(price, 2) : '\u2014') + '</span>' +
    '</div>' +
    '<div class="stat-block">' +
      '<span class="stat-label">Upside / downside</span>' +
      '<span class="stat-value ' + deltaClass + '">' + (delta !== null ? fmtPct(delta, 1) : '\u2014') + '</span>' +
    '</div>';
  el.innerHTML = html;
}

/* ---------------- financials table ---------------- */

function renderFinancialsTable() {
  const years = state.years;
  const pLabels = projYearLabels();
  const headCells = ['<th class="row-label-col">Metric</th>', '<th class="model-col">Model</th>']
    .concat(years.map(y => '<th>' + y + '</th>'))
    .concat(pLabels.map(y => '<th class="proj-col">' + y + '</th>'))
    .join('');

  const bodyRows = [];

  METRIC_DEFS.forEach(({ key, label }) => {
    const m = state.metrics[key];
    const projected = getProjected(key);
    const hasOverrides = Object.keys(m.overrides).length > 0;

    const modelOptions = Object.keys(MODEL_LABELS).map(val => {
      const sel = m.model === val ? ' selected' : '';
      return '<option value="' + val + '"' + sel + '>' + MODEL_LABELS[val] + '</option>';
    }).join('');

    const histCells = m.hist.map((v, i) =>
      '<td><input type="number" step="any" data-role="hist" data-metric="' + key + '" data-index="' + i + '" value="' + v + '"></td>'
    ).join('');

    const projCells = projected.map((v, i) => {
      const overridden = Object.prototype.hasOwnProperty.call(m.overrides, i);
      return '<td class="proj-col' + (overridden ? ' overridden' : '') + '">' +
        '<input type="number" step="any" data-role="proj" data-metric="' + key + '" data-index="' + i + '" value="' + roundSmart(v) + '"></td>';
    }).join('');

    const resetBtn = hasOverrides
      ? '<button type="button" class="reset-btn" data-role="reset-overrides" data-metric="' + key + '" title="Clear manual overrides for this row">reset</button>'
      : '';

    bodyRows.push(
      '<tr class="metric-row">' +
        '<td class="row-label-col">' + label + '</td>' +
        '<td class="model-col"><select data-role="model" data-metric="' + key + '">' + modelOptions + '</select>' + resetBtn + '</td>' +
        histCells + projCells +
      '</tr>'
    );

    if (m.model === 'custom') {
      const rateCells = [];
      for (let i = 0; i < state.projYears; i++) {
        const rate = m.customRates[i] !== undefined ? m.customRates[i] : 0;
        rateCells.push('<td class="proj-col"><input type="number" step="0.1" data-role="rate" data-metric="' + key + '" data-index="' + i + '" value="' + rate + '"> %</td>');
      }
      bodyRows.push(
        '<tr class="rate-row">' +
          '<td class="row-label-col"></td>' +
          '<td class="model-col rate-tag">growth \u21b3</td>' +
          years.map(() => '<td></td>').join('') +
          rateCells.join('') +
        '</tr>'
      );
    }

    if (state.showGrowthRows) {
      const combined = m.hist.concat(projected);
      const cells = combined.map((v, i) => {
        if (i === 0) return '<td></td>';
        const prev = combined[i - 1];
        const g = prev !== 0 ? ((v / prev) - 1) * 100 : null;
        const cls = (i < m.hist.length ? '' : 'proj-col ') + 'growth-cell ' + (g === null ? '' : (g >= 0 ? 'pos' : 'neg'));
        return '<td class="' + cls.trim() + '">' + (g === null ? '\u2014' : fmtPct(g, 1)) + '</td>';
      });
      bodyRows.push(
        '<tr class="growth-row">' +
          '<td class="row-label-col"></td>' +
          '<td class="model-col rate-tag">YoY %</td>' +
          cells.join('') +
        '</tr>'
      );
    }
  });

  $('financialsTable').innerHTML =
    '<thead><tr>' + headCells + '</tr></thead><tbody>' + bodyRows.join('') + '</tbody>';
}

/* ---------------- chart ---------------- */

function renderChart() {
  const ctx = $('growthChart').getContext('2d');
  const labels = state.years.concat(projYearLabels()).map(String);
  const histLen = state.years.length;

  const datasets = [];
  METRIC_DEFS.forEach(({ key, label, color }) => {
    const m = state.metrics[key];
    const projected = getProjected(key);

    const histData = m.hist.concat(new Array(state.projYears).fill(null));
    const projData = new Array(Math.max(histLen - 1, 0)).fill(null)
      .concat([m.hist[histLen - 1]])
      .concat(projected);

    datasets.push({
      label: label, data: histData, borderColor: color, backgroundColor: 'transparent',
      borderWidth: 2, pointRadius: 3, tension: 0.2, spanGaps: false
    });
    datasets.push({
      label: label + ' (proj)', data: projData, borderColor: color, backgroundColor: 'transparent',
      borderWidth: 2, borderDash: [6, 4], pointRadius: 3, tension: 0.2, spanGaps: false
    });
  });

  if (chartInstance) chartInstance.destroy();
  chartInstance = new Chart(ctx, {
    type: 'line',
    data: { labels, datasets },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      interaction: { mode: 'index', intersect: false },
      plugins: {
        legend: {
          labels: {
            color: COLORS.ink,
            filter: (item) => !item.text.includes('(proj)'),
            font: { family: "'Inter', sans-serif", size: 12 }
          }
        },
        tooltip: {
          backgroundColor: '#1C2536', titleColor: COLORS.ink, bodyColor: COLORS.ink,
          borderColor: COLORS.hairline, borderWidth: 1,
          callbacks: {
            label: (item) => {
              if (item.dataset.label.includes('(proj)')) return null;
              const v = item.parsed.y;
              return v === null ? null : item.dataset.label + ': ' + fmt(v, 1) + unitSuffix();
            }
          }
        }
      },
      scales: {
        x: { ticks: { color: COLORS.inkDim, font: { family: "'JetBrains Mono', monospace", size: 11 } }, grid: { color: COLORS.hairline } },
        y: { ticks: { color: COLORS.inkDim, font: { family: "'JetBrains Mono', monospace", size: 11 }, callback: (v) => fmt(v, 0) }, grid: { color: COLORS.hairline } }
      }
    }
  });
}

/* ---------------- DCF ---------------- */

function calcDcfDetail() {
  const fcfArr = getProjected('fcf');
  const wacc = state.dcf.wacc;
  const tgr = state.dcf.tgr;
  const netDebt = state.company.netDebt;
  const shares = state.company.shares;
  const waccD = wacc / 100, tgrD = tgr / 100;

  const rows = fcfArr.map((f, k) => {
    const df = 1 / Math.pow(1 + waccD, k + 1);
    return { year: projYearLabels()[k], fcf: f, df, pv: f * df };
  });
  const sumPV = rows.reduce((s, r) => s + r.pv, 0);

  if (waccD <= tgrD || !fcfArr.length) {
    return { rows, sumPV, valid: false, reason: 'wacc' };
  }
  const lastFcf = fcfArr[fcfArr.length - 1];
  const tv = (lastFcf * (1 + tgrD)) / (waccD - tgrD);
  const pvTv = tv / Math.pow(1 + waccD, fcfArr.length);
  const ev = sumPV + pvTv;
  const equity = ev - netDebt;

  if (!shares) {
    return { rows, sumPV, tv, pvTv, ev, equity, ivPerShare: null, valid: false, reason: 'shares' };
  }
  const ivPerShare = equity / shares;
  return { rows, sumPV, tv, pvTv, ev, equity, ivPerShare, valid: true };
}

function renderDcfTable(detail) {
  const u = unitSuffix();
  const rowsHtml = detail.rows.map(r =>
    '<tr><td>' + r.year + '</td><td>' + fmt(r.fcf, 1) + '</td><td>' + r.df.toFixed(3) + '</td><td>' + fmt(r.pv, 1) + '</td></tr>'
  ).join('');

  let summary;
  if (!detail.valid && detail.reason === 'wacc') {
    summary = '<tr class="dcf-warn"><td colspan="4">Terminal growth must be less than WACC to compute a terminal value.</td></tr>';
  } else if (!detail.valid && detail.reason === 'shares') {
    summary =
      '<tr class="dcf-sum"><td colspan="3">Sum of PV(FCF)</td><td>' + fmt(detail.sumPV, 1) + '</td></tr>' +
      '<tr class="dcf-sum"><td colspan="3">PV(Terminal value)</td><td>' + fmt(detail.pvTv, 1) + '</td></tr>' +
      '<tr class="dcf-sum dcf-strong"><td colspan="3">Enterprise value</td><td>' + fmt(detail.ev, 1) + '</td></tr>' +
      '<tr class="dcf-sum"><td colspan="3">Less: net debt</td><td>' + fmt(state.company.netDebt, 1) + '</td></tr>' +
      '<tr class="dcf-sum"><td colspan="3">Equity value</td><td>' + fmt(detail.equity, 1) + '</td></tr>' +
      '<tr class="dcf-warn"><td colspan="4">Enter diluted shares outstanding above to get an intrinsic value per share.</td></tr>';
  } else {
    summary =
      '<tr class="dcf-sum"><td colspan="3">Sum of PV(FCF)</td><td>' + fmt(detail.sumPV, 1) + '</td></tr>' +
      '<tr class="dcf-sum"><td colspan="3">PV(Terminal value)</td><td>' + fmt(detail.pvTv, 1) + '</td></tr>' +
      '<tr class="dcf-sum dcf-strong"><td colspan="3">Enterprise value</td><td>' + fmt(detail.ev, 1) + '</td></tr>' +
      '<tr class="dcf-sum"><td colspan="3">Less: net debt</td><td>' + fmt(state.company.netDebt, 1) + '</td></tr>' +
      '<tr class="dcf-sum"><td colspan="3">Equity value</td><td>' + fmt(detail.equity, 1) + '</td></tr>' +
      '<tr class="dcf-sum dcf-strong"><td colspan="3">Intrinsic value / share</td><td>' + fmt(detail.ivPerShare, 2) + '</td></tr>';
  }

  $('dcfTable').innerHTML =
    '<thead><tr><th>Year</th><th>FCF (' + u + ')</th><th>Discount factor</th><th>PV (' + u + ')</th></tr></thead>' +
    '<tbody>' + rowsHtml + summary + '</tbody>';
}

/* ---------------- sensitivity ---------------- */

function renderSensitivity() {
  const fcfArr = getProjected('fcf');
  const netDebt = state.company.netDebt;
  const shares = state.company.shares;
  const steps = [-1, -0.5, 0, 0.5, 1];
  const waccRows = steps.map(d => Math.max(0.5, state.dcf.wacc + d));
  const tgrCols = steps.map(d => state.dcf.tgr + d);

  const headCells = ['<th>WACC \\ g</th>'].concat(tgrCols.map(g => '<th>' + g.toFixed(1) + '%</th>')).join('');
  const bodyRows = waccRows.map((w, ri) => {
    const cells = tgrCols.map((g, ci) => {
      const val = calcIntrinsicValue(fcfArr, w, g, netDebt, shares);
      const isBase = (steps[ri] === 0 && steps[ci] === 0);
      return '<td class="' + (isBase ? 'base-cell' : '') + '">' + (val === null ? 'n/a' : fmt(val, 2)) + '</td>';
    }).join('');
    return '<tr><th>' + w.toFixed(1) + '%</th>' + cells + '</tr>';
  }).join('');

  $('sensitivityTable').innerHTML = '<thead><tr>' + headCells + '</tr></thead><tbody>' + bodyRows + '</tbody>';
}

/* ---------------- comps ---------------- */

function renderComps(dcfDetail) {
  const finalIdx = state.projYears - 1;
  const niFinal = getProjected('netIncome')[finalIdx];
  const ebitdaFinal = getProjected('ebitda')[finalIdx];
  const shares = state.company.shares;
  const netDebt = state.company.netDebt;
  const price = state.company.price;

  const rows = [];
  rows.push({ method: 'DCF intrinsic value', price: dcfDetail.valid ? dcfDetail.ivPerShare : null });

  if (state.comps.peerPE && shares) {
    rows.push({ method: 'Peer P/E \u00d7 forward EPS', price: state.comps.peerPE * (niFinal / shares) });
  } else {
    rows.push({ method: 'Peer P/E \u00d7 forward EPS', price: null });
  }

  if (state.comps.peerEvEbitda && shares) {
    const impliedEv = state.comps.peerEvEbitda * ebitdaFinal;
    rows.push({ method: 'Peer EV/EBITDA \u00d7 forward EBITDA', price: (impliedEv - netDebt) / shares });
  } else {
    rows.push({ method: 'Peer EV/EBITDA \u00d7 forward EBITDA', price: null });
  }

  const rowsHtml = rows.map(r => {
    const delta = (r.price !== null && price) ? (r.price / price - 1) * 100 : null;
    const cls = delta === null ? '' : (delta >= 0 ? 'pos' : 'neg');
    return '<tr><td>' + r.method + '</td><td>' + (r.price !== null ? fmt(r.price, 2) : '\u2014') + '</td>' +
      '<td class="' + cls + '">' + (delta !== null ? fmtPct(delta, 1) : '\u2014') + '</td></tr>';
  }).join('');

  $('compsTable').innerHTML =
    '<thead><tr><th>Method</th><th>Implied price</th><th>vs current</th></tr></thead><tbody>' + rowsHtml + '</tbody>';
}

/* ---------------- full render ---------------- */

function syncInputs() {
  $('unitSelect').value = String(state.unitScale);
  $('projYearsInput').value = state.projYears;
  $('growthToggle').checked = state.showGrowthRows;
  $('waccInput').value = state.dcf.wacc;
  $('tgrInput').value = state.dcf.tgr;
  $('netDebtInput').value = roundSmart(state.company.netDebt);
  $('netDebtUnitLabel').textContent = '($' + unitSuffix() + ')';
  $('sharesInput').value = roundSmart(state.company.shares);
  $('peerPeInput').value = state.comps.peerPE;
  $('peerEvInput').value = state.comps.peerEvEbitda;
  if (state.ticker) $('tickerInput').value = state.ticker;
}

function captureFocus() {
  const el = document.activeElement;
  if (!el || !el.dataset || !el.dataset.role) return null;
  return {
    role: el.dataset.role, metric: el.dataset.metric, index: el.dataset.index,
    selStart: (typeof el.selectionStart === 'number') ? el.selectionStart : null,
    selEnd: (typeof el.selectionEnd === 'number') ? el.selectionEnd : null
  };
}

function restoreFocus(info) {
  if (!info) return;
  let sel = '[data-role="' + info.role + '"]';
  if (info.metric !== undefined) sel += '[data-metric="' + info.metric + '"]';
  if (info.index !== undefined && info.index !== null) sel += '[data-index="' + info.index + '"]';
  const el = document.querySelector(sel);
  if (!el) return;
  el.focus();
  if (info.selStart !== null && el.setSelectionRange) {
    try { el.setSelectionRange(info.selStart, info.selEnd); } catch (e) { /* not a text-selectable input, ignore */ }
  }
}

function renderAll() {
  const focusInfo = captureFocus();

  syncInputs();
  renderSnapshot();
  renderFinancialsTable();
  renderChart();
  const detail = calcDcfDetail();
  renderTickerReadout(detail);
  renderDcfTable(detail);
  renderSensitivity();
  renderComps(detail);

  restoreFocus(focusInfo);
}

/* ---------------- events ---------------- */

function initEvents() {
  const table = $('financialsTable');
  table.addEventListener('change', (e) => {
    const t = e.target;
    const role = t.dataset.role;
    if (!role) return;
    const key = t.dataset.metric;
    const m = state.metrics[key];
    const idx = t.dataset.index !== undefined ? parseInt(t.dataset.index, 10) : null;

    if (role === 'hist') {
      m.hist[idx] = clampNum(t.value, 0);
      renderAll();
    } else if (role === 'proj') {
      m.overrides[idx] = clampNum(t.value, 0);
      renderAll();
    } else if (role === 'rate') {
      if (!m.customRates) m.customRates = [];
      m.customRates[idx] = clampNum(t.value, 0);
      renderAll();
    } else if (role === 'model') {
      m.model = t.value;
      renderAll();
    }
  });
  table.addEventListener('click', (e) => {
    const t = e.target;
    if (t.dataset.role === 'reset-overrides') {
      state.metrics[t.dataset.metric].overrides = {};
      renderAll();
    }
  });

  $('unitSelect').addEventListener('change', (e) => {
    rescaleUnits(parseFloat(e.target.value));
    renderAll();
  });
  $('projYearsInput').addEventListener('change', (e) => {
    state.projYears = Math.max(1, Math.min(10, parseInt(e.target.value, 10) || 5));
    renderAll();
  });
  $('growthToggle').addEventListener('change', (e) => {
    state.showGrowthRows = e.target.checked;
    renderAll();
  });
  $('addYearBtn').addEventListener('click', () => {
    const newYear = state.years[0] - 1;
    state.years.unshift(newYear);
    METRIC_DEFS.forEach(({ key }) => state.metrics[key].hist.unshift(0));
    renderAll();
  });
  $('removeYearBtn').addEventListener('click', () => {
    if (state.years.length <= 2) return;
    state.years.shift();
    METRIC_DEFS.forEach(({ key }) => state.metrics[key].hist.shift());
    renderAll();
  });

  $('waccInput').addEventListener('change', (e) => { state.dcf.wacc = clampNum(e.target.value, 9); renderAll(); });
  $('tgrInput').addEventListener('change', (e) => { state.dcf.tgr = clampNum(e.target.value, 2.5); renderAll(); });
  $('netDebtInput').addEventListener('change', (e) => { state.company.netDebt = clampNum(e.target.value, 0); renderAll(); });
  $('sharesInput').addEventListener('change', (e) => { state.company.shares = clampNum(e.target.value, 0); renderAll(); });
  $('peerPeInput').addEventListener('change', (e) => { state.comps.peerPE = clampNum(e.target.value, 0); renderAll(); });
  $('peerEvInput').addEventListener('change', (e) => { state.comps.peerEvEbitda = clampNum(e.target.value, 0); renderAll(); });

  $('showKeyBtn').addEventListener('click', () => {
    const input = $('apiKeyInput');
    input.type = input.type === 'password' ? 'text' : 'password';
  });

  $('fetchBtn').addEventListener('click', handleFetch);
  $('tickerInput').addEventListener('keydown', (e) => { if (e.key === 'Enter') handleFetch(); });

  $('exportCsvBtn').addEventListener('click', exportCsv);
  $('exportJsonBtn').addEventListener('click', exportJson);
  $('importJsonInput').addEventListener('change', importJson);
}

/* ---------------- data fetch ---------------- */

async function handleFetch() {
  const ticker = $('tickerInput').value.trim().toUpperCase();
  const key = $('apiKeyInput').value.trim();
  if (!ticker) { setStatus('Enter a ticker symbol first.', 'warn'); return; }
  if (!key) { setStatus('Enter a Financial Modeling Prep API key to auto-fetch \u2014 or just type figures into the table manually below.', 'warn'); return; }

  setStatus('Fetching ' + ticker + '\u2026', 'loading');
  $('fetchBtn').disabled = true;

  const qs = '?symbol=' + encodeURIComponent(ticker) + '&apikey=' + encodeURIComponent(key);
  const urls = {
    profile: FMP_BASE + 'profile' + qs,
    quote: FMP_BASE + 'quote' + qs,
    income: FMP_BASE + 'income-statement' + qs + '&limit=10',
    cash: FMP_BASE + 'cash-flow-statement' + qs + '&limit=10',
    balance: FMP_BASE + 'balance-sheet-statement' + qs + '&limit=10'
  };

  try {
    const [profileR, quoteR, incomeR, cashR, balanceR] = await Promise.allSettled([
      fetch(urls.profile).then(r => r.json()),
      fetch(urls.quote).then(r => r.json()),
      fetch(urls.income).then(r => r.json()),
      fetch(urls.cash).then(r => r.json()),
      fetch(urls.balance).then(r => r.json())
    ]);

    const profile = profileR.status === 'fulfilled' ? (Array.isArray(profileR.value) ? profileR.value[0] : profileR.value) : null;
    const quote = quoteR.status === 'fulfilled' ? (Array.isArray(quoteR.value) ? quoteR.value[0] : quoteR.value) : null;
    const income = incomeR.status === 'fulfilled' && Array.isArray(incomeR.value) ? incomeR.value : [];
    const cash = cashR.status === 'fulfilled' && Array.isArray(cashR.value) ? cashR.value : [];
    const balance = balanceR.status === 'fulfilled' && Array.isArray(balanceR.value) ? balanceR.value : [];

    const failures = [];
    if (!profile) failures.push('profile');
    if (!quote) failures.push('quote');
    if (!income.length) failures.push('income statement');
    if (!cash.length) failures.push('cash flow');
    if (!balance.length) failures.push('balance sheet');

    if (income.length) {
      const incByYear = {}, cashByYear = {};
      income.forEach(row => { const y = getRowYear(row); if (y) incByYear[y] = row; });
      cash.forEach(row => { const y = getRowYear(row); if (y) cashByYear[y] = row; });
      const years = Object.keys(incByYear).map(Number).sort((a, b) => a - b);

      state.years = years;
      state.metrics.revenue.hist = years.map(y => pick(incByYear[y], ['revenue'], 0) / state.unitScale);
      state.metrics.ebitda.hist = years.map(y => pick(incByYear[y], ['ebitda'], 0) / state.unitScale);
      state.metrics.netIncome.hist = years.map(y => pick(incByYear[y], ['netIncome'], 0) / state.unitScale);
      state.metrics.fcf.hist = years.map(y => cashByYear[y] ? calcFCFRow(cashByYear[y]) / state.unitScale : 0);
      METRIC_DEFS.forEach(({ key }) => { state.metrics[key].overrides = {}; state.metrics[key].customRates = []; });
    }

    if (balance.length) {
      const sorted = balance.slice().sort((a, b) => getRowYear(b) - getRowYear(a));
      const latest = sorted[0];
      const totalDebt = pick(latest, ['totalDebt'], 0);
      const cashBal = pick(latest, ['cashAndCashEquivalents', 'cashAndShortTermInvestments'], 0);
      state.company.netDebt = (totalDebt - cashBal) / state.unitScale;
    }

    const sharesRaw = pick(quote, ['sharesOutstanding'], null) || pick(profile, ['sharesOutstanding'], null);
    const priceRaw = pick(quote, ['price'], null) || pick(profile, ['price'], 0);
    const mktCapRaw = pick(quote, ['marketCap'], null) || pick(profile, ['mktCap'], 0);

    state.company.name = pick(profile, ['companyName'], ticker);
    state.company.sector = pick(profile, ['sector'], '');
    state.company.exchange = pick(profile, ['exchange', 'exchangeShortName'], '');
    state.company.currency = pick(profile, ['currency'], 'USD');
    state.company.price = priceRaw || 0;
    state.company.marketCap = mktCapRaw || 0;
    state.company.shares = (sharesRaw || (priceRaw ? mktCapRaw / priceRaw : 0)) / 1e6;
    state.ticker = ticker;

    if (failures.length) {
      setStatus('Loaded ' + ticker + ' with partial data \u2014 missing: ' + failures.join(', ') + '. Fill the gaps in manually below.', 'warn');
    } else {
      setStatus('Loaded ' + ticker + ' \u2014 financials pulled in. Everything below is still editable.', 'ok');
    }
  } catch (err) {
    setStatus('Could not reach Financial Modeling Prep (' + err.message + '). Check your key and connection, or fill in the table manually.', 'error');
  } finally {
    $('fetchBtn').disabled = false;
    renderAll();
  }
}

/* ---------------- export / import ---------------- */

function downloadBlob(content, filename, type) {
  const blob = new Blob([content], { type });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = filename;
  document.body.appendChild(a); a.click(); document.body.removeChild(a);
  URL.revokeObjectURL(url);
}

function exportCsv() {
  const pLabels = projYearLabels();
  const header = ['Metric'].concat(state.years).concat(pLabels).join(',');
  const lines = METRIC_DEFS.map(({ key, label }) => {
    const m = state.metrics[key];
    const projected = getProjected(key);
    return [label].concat(m.hist).concat(projected.map(v => roundSmart(v))).join(',');
  });
  const csv = header + '\n' + lines.join('\n');
  const name = (state.ticker || 'model') + '-valuation.csv';
  downloadBlob(csv, name, 'text/csv');
}

function exportJson() {
  const payload = {
    ticker: state.ticker, years: state.years, projYears: state.projYears,
    unitScale: state.unitScale, company: state.company, metrics: state.metrics,
    dcf: state.dcf, comps: state.comps
  };
  const name = (state.ticker || 'model') + '-valuation.json';
  downloadBlob(JSON.stringify(payload, null, 2), name, 'application/json');
}

function importJson(e) {
  const file = e.target.files[0];
  if (!file) return;
  const reader = new FileReader();
  reader.onload = () => {
    try {
      const parsed = JSON.parse(reader.result);
      state.ticker = parsed.ticker || '';
      state.years = parsed.years || state.years;
      state.projYears = parsed.projYears || state.projYears;
      state.unitScale = parsed.unitScale || state.unitScale;
      state.company = Object.assign(state.company, parsed.company || {});
      state.metrics = parsed.metrics || state.metrics;
      state.dcf = Object.assign(state.dcf, parsed.dcf || {});
      state.comps = Object.assign(state.comps, parsed.comps || {});
      setStatus('Model loaded from file.', 'ok');
      renderAll();
    } catch (err) {
      setStatus('Could not read that file (' + err.message + ').', 'error');
    }
  };
  reader.readAsText(file);
  e.target.value = '';
}

/* ---------------- boot ---------------- */

document.addEventListener('DOMContentLoaded', () => {
  initEvents();
  renderAll();
});

</script>
  </body>
</html>
