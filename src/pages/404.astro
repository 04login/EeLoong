---
import "../styles/global.css";

export const prerender = true;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Not found — Ee Loong Low</title>
  </head>
  <body class="min-h-screen bg-[color:var(--ink-900)] text-[color:var(--paper)]">
    <main class="px-8 py-20 max-w-xl">
      <p class="text-sm font-semibold uppercase tracking-[0.24em] text-[color:var(--paper-dim)]">404</p>
      <h1 class="mt-3 text-4xl font-semibold">This page isn't here.</h1>
      <p class="mt-3 text-[color:var(--paper-muted)] leading-relaxed">The link may be old, or the address is wrong.</p>
      <a href="/" class="mt-8 inline-flex items-center rounded-lg bg-[color:var(--accent)] px-4 py-2 text-sm font-semibold text-white hover:bg-[color:var(--accent-light)] transition">Back to the portfolio</a>
    </main>
  </body>
</html>
