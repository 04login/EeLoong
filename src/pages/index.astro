												<div class="flex items-center justify-center gap-1 flex-wrap">
													{edu.schools.map((school, index) => (
														<>
															<a class="text-xs font-semibold">{school.name}</a>
															{index < edu.schools.length - 1 && (
																<iconify-icon
																	icon="mdi:close"
																	class="text-[color:var(--accent)] text-sm"
																></iconify-icon>
															)}
														</>
													))}
												</div>
