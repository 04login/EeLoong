									style="animation: progression-flow 5s linear infinite;"
								></div>
								<div
									class="absolute md:hidden left-1/2 top-0 bottom-0 w-[2px] -translate-x-1/2 bg-gradient-to-b from-[color:var(--accent)] via-[color:var(--ink-500)] to-[color:var(--accent)] bg-[length:100%_200%]"
									style="animation: progression-flow 5s linear infinite;"
								></div> -->
								
								<!-- Cards container -->
								<div class="relative flex flex-col md:flex-row gap-8 md:gap-25">
								{education.map((edu) => (
									<div
										class="relative flex flex-col items-center gap-2 p-4 border border-[color:var(--ink-300)] rounded-xl bg-white transition hover:border-[color:var(--accent)] hover:shadow-lg hover:shadow-[color:var(--accent)]/10"
									>
										<div
											class={`w-full h-12 flex items-center ${edu.schools.length > 1 ? 'justify-between gap-7' : 'justify-center'}`}
										>
											{edu.schools.map((school) => (
												<img
													src={school.logo}
													alt={school.name}
													class="h-full w-auto object-contain"
												/>
											))}
										</div>
										<div class="text-center text-[color:var(--ink-700)]">
