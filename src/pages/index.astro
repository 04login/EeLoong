---
import "../styles/global.css";
import { me, education, workExperience, projects, skills } from "../data/profile.ts";

const nameStack = me.name.trim().replace(/\s+/g, "\n");
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/龙.jpg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{me.name}</title>
		<script
			type="module"
			src="https://cdn.jsdelivr.net/npm/iconify-icon@1/dist/iconify-icon.min.js"
		></script>
	</head>
	<body
		class="min-h-screen bg-[color:var(--ink-900)] text-[color:var(--paper)]"
	>
		<main class="min-h-screen">
			<div class="grid min-h-screen grid-cols-1 lg:grid-cols-[1fr_auto]">
				<div class="flex flex-col justify-start gap-0 mx-3 my-3 md:mx-5 md:my-5 lg:order-1 mb-32 lg:mb-5">
					<!-- Education section -->
					<div
						class="flex-1 flex flex-col gap-6 md:gap-10 py-4 md:py-8 bg-[color:var(--ink-900)]"
					>
					<!-- Wrap header in a flex for side by side -->
					<div class="flex items-center gap-3 md:gap-5">
						<iconify-icon
							icon="material-symbols:school"
							class="text-[color:var(--paper-dim)] text-lg md:text-xl"
						></iconify-icon>
						<p
							class="text-sm md:text-xl font-semibold uppercase tracking-[0.24em] text-[color:var(--paper-dim)]"
						>
							My Educational Journey
						</p>
					</div>
						
					<!-- Cards container -->
					<div class="flex flex-col md:flex-row gap-6 md:gap-8">
						{education.map((edu) => (
							<div
								class="relative flex flex-col gap-4 p-5 md:p-6 border border-[color:var(--ink-600)] rounded-xl bg-[color:var(--ink-800)] hover:border-[color:var(--accent)] hover:shadow-lg hover:shadow-[color:var(--accent)]/10 transition md:flex-1"
							>
								{/* Logos section */}
								{edu.schools.length > 1 ? (
									<div class="flex items-center justify-center gap-6">
										{edu.schools.map((school, index) => (
											<>
												<div class="flex flex-col items-center gap-2">
<div class="w-28 h-28 flex items-center justify-center 
            bg-[color:var(--paper)] 
            rounded-lg p-2">
  <img
    src={school.logo}
    alt={school.name}
    class="max-w-full max-h-full object-contain"
  />
</div>
													<p class="text-xs font-semibold text-[color:var(--paper)] text-center">{school.name}</p>
												</div>
												{index < edu.schools.length - 1 && (
													<iconify-icon
														icon="mdi:close"
														class="text-[color:var(--accent)] text-2xl flex-shrink-0"
													></iconify-icon>
												)}
											</>
										))}
									</div>
								) : (
									<div class="flex flex-col items-center gap-2">
<div class="w-28 h-28 flex items-center justify-center 
            bg-[color:var(--paper)] 
            rounded-lg p-2">
  <img
    src={school.logo}
    alt={school.name}
    class="max-w-full max-h-full object-contain"
  />
</div>
										<p class="text-sm font-semibold text-[color:var(--paper)]">{edu.schools[0].name}</p>
									</div>
								)}

								{/* Degree info */}
								<div class="flex flex-col gap-2 text-center border-t border-[color:var(--ink-600)] pt-4">
									<p class="text-sm text-[color:var(--paper-muted)] leading-relaxed">
										{edu.degree}
									</p>
									<div class="flex items-center justify-center gap-2 text-xs text-[color:var(--paper-dim)]">
										<iconify-icon icon="mdi:calendar-outline" class="text-[color:var(--accent)]"></iconify-icon>
										<span>{edu.period}</span>
									</div>
									{edu.isCurrent && (
										<span class="px-3 py-1 text-xs font-semibold rounded-full bg-[color:var(--accent)]/10 text-[color:var(--accent)] border border-[color:var(--accent)]/30 self-center mt-2">
											Current
										</span>
									)}
								</div>
							</div>
						))}
					</div>
					</div>

					<!-- Work Experience section -->
					<div class="flex flex-col gap-6 md:gap-10 py-4 md:py-8 bg-[color:var(--ink-850)] -mx-3 md:-mx-5 px-3 md:px-5">
						<div class="flex items-center gap-3 md:gap-5">
							<iconify-icon
								icon="mdi:briefcase-outline"
								class="text-[color:var(--paper-dim)] text-lg md:text-xl"
							></iconify-icon>
							<p class="text-sm md:text-xl font-semibold uppercase tracking-[0.24em] text-[color:var(--paper-dim)]">
								Work Experience
							</p>
						</div>

						<div class="flex flex-col gap-6">
							{workExperience.map((work) => (
								<div class="relative flex flex-col gap-4 p-5 md:p-6 border border-[color:var(--ink-600)] rounded-xl bg-[color:var(--ink-800)] hover:border-[color:var(--accent)] hover:shadow-lg hover:shadow-[color:var(--accent)]/10 transition">
									<div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4">
										<div class="flex items-start gap-4">
											{work.logo && (
												<div class="flex-shrink-0 w-16 h-16 flex items-center justify-center">
													<img
														src={work.logo}
														alt={work.company}
														class="max-w-full max-h-full object-contain"
													/>
												</div>
											)}
											<div class="flex flex-col gap-1">
												<h3 class="text-xl font-bold text-[color:var(--paper)]">{work.company}</h3>
												<p class="text-sm font-semibold text-[color:var(--accent)]">{work.role}</p>
												<span class="text-xs text-[color:var(--paper-dim)] flex items-center gap-1 mt-1">
													<iconify-icon icon="mdi:calendar-outline" class="text-[color:var(--accent)]"></iconify-icon>
													{work.period}
												</span>
											</div>
										</div>
										{work.current && (
											<span class="px-3 py-1 text-xs font-semibold rounded-full bg-[color:var(--accent)]/10 text-[color:var(--accent)] border border-[color:var(--accent)]/30 self-start">
												Current
											</span>
										)}
									</div>
									<ul class="flex flex-col gap-2 text-sm text-[color:var(--paper-muted)]">
										{work.achievements.map((achievement) => (
											<li class="flex gap-2">
												<iconify-icon icon="mdi:chevron-right" class="text-[color:var(--accent)] mt-0.5 flex-shrink-0"></iconify-icon>
												<span>{achievement}</span>
											</li>
										))}
									</ul>
									{work.technologies.length > 0 && (
										<div class="flex flex-wrap gap-2 pt-2 border-t border-[color:var(--ink-600)]">
											{work.technologies.map((tech) => (
												<span class="px-3 py-1 text-xs rounded-md bg-[color:var(--ink-700)] text-[color:var(--accent)] border border-[color:var(--accent)]/20">
													{tech}
												</span>
											))}
										</div>
									)}
								</div>
							))}
						</div>
					</div>

					<!-- Projects section -->
					<div class="flex flex-col gap-6 md:gap-10 py-4 md:py-8 bg-[color:var(--ink-800)] -mx-3 md:-mx-5 px-3 md:px-5">
						<div class="flex items-center gap-3 md:gap-5">
							<iconify-icon
								icon="mdi:rocket-launch-outline"
								class="text-[color:var(--paper-dim)] text-lg md:text-xl"
							></iconify-icon>
							<p class="text-sm md:text-xl font-semibold uppercase tracking-[0.24em] text-[color:var(--paper-dim)]">
								Projects
							</p>
						</div>

						<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
							{projects.map((project) => (
								<div class="relative flex flex-col gap-3 p-4 md:p-5 border border-[color:var(--ink-600)] rounded-xl bg-[color:var(--ink-850)] hover:border-[color:var(--accent)] hover:shadow-lg hover:shadow-[color:var(--accent)]/10 transition group">
									<div class="flex items-start justify-between gap-2">
										<h3 class="text-lg font-bold text-[color:var(--paper)] group-hover:text-[color:var(--accent)] transition">{project.title}</h3>
										{project.link && (
											<a href={project.link} target="_blank" rel="noopener noreferrer" class="text-[color:var(--accent)] hover:text-[color:var(--paper)] transition">
												<iconify-icon icon="mdi:open-in-new" class="text-xl"></iconify-icon>
											</a>
										)}
									</div>
									<p class="text-xs font-semibold text-[color:var(--accent)]">{project.role}</p>
									<p class="text-xs text-[color:var(--paper-dim)] flex items-center gap-1">
										<iconify-icon icon="mdi:calendar-outline"></iconify-icon>
										{project.period}
									</p>
									<p class="text-sm text-[color:var(--paper-muted)] leading-relaxed">{project.description}</p>
									<ul class="flex flex-col gap-1 text-xs text-[color:var(--paper-muted)]">
										{project.achievements.slice(0, 2).map((achievement) => (
											<li class="flex gap-1">
												<iconify-icon icon="mdi:check" class="text-[color:var(--accent)] mt-0.5 flex-shrink-0"></iconify-icon>
												<span>{achievement}</span>
											</li>
										))}
									</ul>
									<div class="flex flex-wrap gap-2 mt-auto pt-3">
										{project.technologies.map((tech) => (
											<span class="px-2 py-1 text-xs rounded-md bg-[color:var(--ink-700)] text-[color:var(--paper-dim)] border border-[color:var(--ink-600)]">
												{tech}
											</span>
										))}
									</div>
								</div>
							))}
						</div>
					</div>

					<!-- Skills section -->
					<div class="flex flex-col gap-6 md:gap-10 py-4 md:py-8 bg-[color:var(--ink-750)] -mx-3 md:-mx-5 px-3 md:px-5">
						<div class="flex items-center gap-3 md:gap-5">
							<iconify-icon
								icon="mdi:code-braces"
								class="text-[color:var(--paper-dim)] text-lg md:text-xl"
							></iconify-icon>
							<p class="text-sm md:text-xl font-semibold uppercase tracking-[0.24em] text-[color:var(--paper-dim)]">
								Skills & Technologies
							</p>
						</div>

						<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
							<div class="flex flex-col gap-3">
								<h3 class="text-base font-bold text-[color:var(--accent)] flex items-center gap-2">
									<iconify-icon icon="mdi:code-tags"></iconify-icon>
									Programming Languages
								</h3>
								<div class="flex flex-wrap gap-2">
									{skills.languages.map((lang) => (
										<span class="px-3 py-1.5 text-sm rounded-lg bg-[color:var(--ink-800)] text-[color:var(--paper)] border border-[color:var(--ink-600)] hover:border-[color:var(--accent)] hover:text-[color:var(--accent)] transition">
											{lang}
										</span>
									))}
								</div>
							</div>

							<div class="flex flex-col gap-3">
								<h3 class="text-base font-bold text-[color:var(--accent)] flex items-center gap-2">
									<iconify-icon icon="mdi:tools"></iconify-icon>
									Tools & Libraries
								</h3>
								<div class="flex flex-wrap gap-2">
									{skills.tools.map((tool) => (
										<span class="px-3 py-1.5 text-sm rounded-lg bg-[color:var(--ink-800)] text-[color:var(--paper)] border border-[color:var(--ink-600)] hover:border-[color:var(--accent)] hover:text-[color:var(--accent)] transition">
											{tool}
										</span>
									))}
								</div>
							</div>

							<div class="flex flex-col gap-3">
								<h3 class="text-base font-bold text-[color:var(--accent)] flex items-center gap-2">
									<iconify-icon icon="mdi:school-outline"></iconify-icon>
									CS Fundamentals
								</h3>
								<div class="flex flex-wrap gap-2">
									{skills.fundamentals.map((fund) => (
										<span class="px-3 py-1.5 text-sm rounded-lg bg-[color:var(--ink-800)] text-[color:var(--paper)] border border-[color:var(--ink-600)] hover:border-[color:var(--accent)] hover:text-[color:var(--accent)] transition">
											{fund}
										</span>
									))}
								</div>
							</div>

							<div class="flex flex-col gap-3">
								<h3 class="text-base font-bold text-[color:var(--accent)] flex items-center gap-2">
									<iconify-icon icon="mdi:account-group-outline"></iconify-icon>
									Soft Skills
								</h3>
								<div class="flex flex-wrap gap-2">
									{skills.soft.map((soft) => (
										<span class="px-3 py-1.5 text-sm rounded-lg bg-[color:var(--ink-800)] text-[color:var(--paper)] border border-[color:var(--ink-600)] hover:border-[color:var(--accent)] hover:text-[color:var(--accent)] transition">
											{soft}
										</span>
									))}
								</div>
							</div>
						</div>
					</div>
				</div>
				<div
					class="fixed lg:static bottom-0 left-0 right-0 z-50 bg-[color:var(--ink-900)] flex min-h-auto lg:min-h-screen flex-col items-start justify-center gap-3 md:gap-4 p-5 md:p-10 text-left lg:sticky lg:top-0 lg:self-start lg:order-2 border-t lg:border-t-0 border-[color:var(--ink-700)]"
				>
					<div class="text-5xl md:text-7xl lg:text-9xl font-semibold">
						<span class="lg:hidden">{me.name}</span>
						<span class="hidden lg:block whitespace-pre-line">{nameStack}</span>
					</div>
					<div class="flex gap-2 md:gap-3 text-sm">
						<a
							class="flex h-8 w-8 md:h-9 md:w-9 items-center justify-center rounded-full border border-[color:var(--ink-500)] text-[color:var(--paper)] transition hover:border-[color:var(--accent)] hover:text-[color:var(--accent)]"
							href={me.Email}
							aria-label="Email"
						>
							<iconify-icon
								icon="mdi:email-outline"
								class="inline-flex h-5 w-5 items-center justify-center"
							></iconify-icon>
						</a>
						<a
							class="flex h-8 w-8 md:h-9 md:w-9 items-center justify-center rounded-full border border-[color:var(--ink-500)] text-[color:var(--paper)] transition hover:border-[color:var(--accent)] hover:text-[color:var(--accent)]"
							href={me.LinkedIn}
							target="_blank"
							rel="noreferrer"
							aria-label="LinkedIn"
						>
							<iconify-icon
								icon="mdi:linkedin"
								class="inline-flex h-5 w-5 items-center justify-center"
							></iconify-icon>
						</a>
						<a
							class="flex h-8 w-8 md:h-9 md:w-9 items-center justify-center rounded-full border border-[color:var(--ink-500)] text-[color:var(--paper)] transition hover:border-[color:var(--accent)] hover:text-[color:var(--accent)]"
							href="https://github.com"
							target="_blank"
							rel="noreferrer"
							aria-label="GitHub"
						>
							<iconify-icon
								icon="mdi:github"
								class="inline-flex h-5 w-5 items-center justify-center"
							></iconify-icon>
						</a>
					</div>
				</div>
			</div>
		</main>
	</body>
</html>
